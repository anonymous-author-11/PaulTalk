import core;
import keyed.map;

def empty() -> i8 {
    return 0 as i8;
}

def deleted() -> i8 {
    return -2 as i8;
}

def occupied_mask() -> i8 {
    return 1 as i8;
}

def group_width() -> i32 {
    return 32;
}

def padding() -> i8 {
    return -1 as i8;
}

class SwissMap[K, V] extends Map[K, V] {
    @keys : Buffer[K]
    @values : Buffer[V]
    @hashes : Buffer[i32]
    @metadata : Buffer[i8]
    @entries_len : i32
    @size : i32
    @hasher : (K) -> i32
    @eq : (K, K) -> Bool

    regions { @elems_reg == @keys == @values }

    getter @size

    def Self.h2_to_control(hash : i32) -> i8 {
        h2_6bit = (hash >> 26) as i8;
        return (h2_6bit << 1) bit_or occupied_mask();
    }

    def Self.min_capacity() -> i32 {
        return group_width() * 4;
    }

    def init(@hasher : (K) -> i32, @eq : (K, K) -> Bool) {
        initial_capacity = Self.min_capacity();
        padded_capacity = initial_capacity + group_width();
        @keys = Buffer[K].new(padded_capacity);
        @values = Buffer[V].new(padded_capacity);
        @hashes = Buffer[i32].new(padded_capacity);
        @metadata = Buffer[i8].new(padded_capacity);
        @entries_len = initial_capacity;
        @size = 0;

        for i in initial_capacity..padded_capacity {
            @metadata.[i] = padding();
        }
    }

    def hash(key : K) -> i32 {
        return @hasher.call(key);
    }

    def same_key(left : K, right : K) -> Bool {
        return @eq.call(left, right);
    }

    def matches_slot(slot : i32, key : K, hash : i32) -> Bool {
        if @hashes.[slot] != hash { return false; }
        slot_key = @keys.[slot];
        return self.same_key(slot_key, key);
    }

    def find_slot(key : K, hash : i32) -> i32 {
        mask = @entries_len - 1;
        h2 = Self.h2_to_control(hash);
        probe = hash bit_and mask;
        tombstone = -1;
        metadata = @metadata;

        first_metadata = metadata.[probe];
        if first_metadata == empty() { return probe; }
        if first_metadata == h2 {
            if self.matches_slot(probe, key, hash) { return probe; }
        }

        probe = probe + 1;
        h2_splat = 32 of h2;
        zero_splat = 32 of empty();
        one_splat = 32 of occupied_mask();

        while true {
            group = metadata.[32 from probe];

            h2_matches = group == h2_splat;
            i = cttz(h2_matches);
            while i < group_width() {
                slot = probe + i;
                if self.matches_slot(slot, key, hash) { return slot; }
                h2_matches = blsr(h2_matches);
                i = cttz(h2_matches);
            }

            empty_matches = group == zero_splat;
            i = cttz(empty_matches);
            if i < group_width() {
                if tombstone >= 0 { return tombstone; }
                return probe + i;
            }

            if tombstone < 0 {
                lsb = group bit_and one_splat;
                deleted_matches = lsb == zero_splat;
                i = cttz(deleted_matches);
                if i < group_width() {
                    tombstone = probe + i;
                }
            }

            probe = (probe + group_width()) bit_and mask;
        }
    }

    def find_empty_slot(hash : i32) -> i32 {
        mask = @entries_len - 1;
        probe = hash bit_and mask;
        metadata = @metadata;

        if metadata.[probe] == empty() { return probe; }
        probe = probe + 1;

        zero_splat = 32 of empty();
        one_splat = 32 of occupied_mask();

        while true {
            group = metadata.[32 from probe];
            lsb = group bit_and one_splat;
            sentinel_matches = lsb == zero_splat;
            i = cttz(sentinel_matches);
            if i < group_width() { return probe + i; }
            probe = (probe + group_width()) bit_and mask;
        }
    }

    def insert(key : K, value : V) {
        hash = self.hash(key);
        self.ensure_capacity(@size + 1);
        slot = self.find_slot(key, hash);
        is_new = (@metadata.[slot] bit_and occupied_mask()) == 0;
        if is_new { @size = @size + 1; }
        @metadata.[slot] = Self.h2_to_control(hash);
        @keys.[slot] = key;
        @values.[slot] = value;
        @hashes.[slot] = hash;
    }

    def get(key : K) -> V? {
        if @size == 0 { return nil; }
        hash = self.hash(key);
        slot = self.find_slot(key, hash);
        if (@metadata.[slot] bit_and occupied_mask()) == 0 { return nil; }
        return @values.[slot];
    }

    def remove(key : K) -> V? {
        if @size == 0 { return nil; }
        hash = self.hash(key);
        slot = self.find_slot(key, hash);
        if (@metadata.[slot] bit_and occupied_mask()) == 0 { return nil; }
        value = @values.[slot];
        @metadata.[slot] = deleted();
        @hashes.[slot] = 0;
        @size = @size - 1;
        return value;
    }

    def ensure_capacity(required_size : i32) {
        if required_size <= (@entries_len * 7) / 8 { return; }
        new_capacity = @entries_len * 2;
        min_capacity = Self.min_capacity();
        if new_capacity < min_capacity { new_capacity = min_capacity; }
        self.resize(new_capacity);
    }

    def resize(new_capacity : i32) {
        old_keys = @keys;
        old_values = @values;
        old_hashes = @hashes;
        old_metadata = @metadata;
        old_len = @entries_len;

        padded_capacity = new_capacity + group_width();
        @keys = Buffer[K].new(padded_capacity);
        @values = Buffer[V].new(padded_capacity);
        @hashes = Buffer[i32].new(padded_capacity);
        @metadata = Buffer[i8].new(padded_capacity);
        @entries_len = new_capacity;
        @size = 0;

        for i in new_capacity..padded_capacity {
            @metadata.[i] = padding();
        }

        for i in 0..old_len {
            if (old_metadata.[i] bit_and occupied_mask()) == 0 { continue; }
            hash = old_hashes.[i];
            slot = self.find_empty_slot(hash);
            @keys.[slot] = old_keys.[i];
            @values.[slot] = old_values.[i];
            @hashes.[slot] = hash;
            @metadata.[slot] = Self.h2_to_control(hash);
            @size = @size + 1;
        }
    }

    def clear() {
        initial_capacity = Self.min_capacity();
        padded_capacity = initial_capacity + group_width();
        @keys = Buffer[K].new(padded_capacity);
        @values = Buffer[V].new(padded_capacity);
        @hashes = Buffer[i32].new(padded_capacity);
        @metadata = Buffer[i8].new(padded_capacity);
        @entries_len = initial_capacity;
        @size = 0;

        for i in initial_capacity..padded_capacity {
            @metadata.[i] = padding();
        }
    }

    def scan_next(start_cursor : i32) -> Pair[i32, Pair[K, V]]? {
        if start_cursor >= @entries_len { return nil; }

        for cursor in start_cursor..@entries_len {
            if (@metadata.[cursor] bit_and occupied_mask()) == 0 { continue; }
            key = @keys.[cursor];
            value = @values.[cursor];
            return Pair{cursor + 1, Pair{key, value}};
        }
        return nil;
    } ~> { ret.second holds @elems_reg }

    def iterator() -> SwissMapIterator[K, V] {
        return SwissMapIterator{self};
    } ~> { ret.map == self }
}

class SwissMapIterator[K, V] extends Iterator[Pair[K, V]] {
    @map : SwissMap[K, V]
    @cursor : i32

    regions { @elems_reg == @map.elems_reg }

    def init(@map : SwissMap[K, V]) {
        @cursor = 0;
    }

    def next() -> Pair[K, V]? {
        pair = @map.scan_next(@cursor);
        if pair is Nil { return nil; }
        (@cursor, entry) = pair;
        return entry;
    }
}
