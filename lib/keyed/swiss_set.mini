import set;
import swiss_store;

class SwissSet[T] extends HashSet[T] {
    def init(hasher : (T) -> i32, eq : (T, T) -> Bool) {
        @store = SwissSetStore{hasher, eq};
    }
}

class SwissSetStore[T] extends SwissStore[T, T, T] {
    @keys : Buffer[T]

    regions { @elems_reg == @keys }

    def init(@hasher : (T) -> i32, @eq : (T, T) -> Bool) {
        entries_len = min_capacity();
        capacity = padded_capacity(entries_len);
        @keys = Buffer[T].new(entries_len);
        @hashes = Buffer[i32].new(entries_len);
        @metadata = Buffer[i8].new(capacity);
        @entries_len = entries_len;
        @size = 0;

        for i in entries_len..capacity { @metadata.[i] = padding(); }
    }

    def value_at(index : i32) -> T {
        return @keys.[index];
    }

    def key_at(index : i32) -> T {
        return @keys.[index];
    }

    def set_value_at(index : i32, value : T) {
        @keys.[index] = value;
    }

    def set_key_at(index : i32, key : T) {
        @keys.[index] = key;
    }

    def reset_records(capacity : i32) {
        @keys = Buffer[T].new(capacity);
    }

    def resize(new_capacity : i32) {
        old_keys = @keys;
        old_metadata = @metadata;
        old_hashes = @hashes;
        old_len = @entries_len;
        self.reset_table(new_capacity);

        for i in 0..old_len {
            if (old_metadata.[i] bit_and occupied_mask()) == 0 { continue; }
            hash = old_hashes.[i];
            slot = self.find_slot_for_new_hash(hash);
            @keys.[slot] = old_keys.[i];
            @hashes.[slot] = hash;
            @metadata.[slot] = h2_to_control(hash);
            @size = @size + 1;
        }
    }

    def scan_next(start_cursor : i32) -> Pair[i32, T]? {
        if start_cursor >= @entries_len { return nil; }

        for cursor in start_cursor..@entries_len {
            if (@metadata.[cursor] bit_and occupied_mask()) == 0 { continue; }
            return Pair{cursor + 1, @keys.[cursor]};
        }
        return nil;
    }

}