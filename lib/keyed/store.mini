import collection;

class KeyedStore[K, V, T] extends Collection[T] {
    abstract def get_value(key : K) -> V? {}
    abstract def put_value(key : K, value : V) -> V? {}
    abstract def remove_value(key : K) -> V? {}
    abstract def clear() {}

    def contains_key(key : K) -> Bool {
        return self.get_value(key) is V;
    }
}

class HashStore[K, V, T] extends KeyedStore[K, V, T] {
    abstract def hash(key : K) -> i32 {}
    abstract def same_key(left : K, right : K) -> Bool {}
}
