import keyed.map;
import keyed.swiss_store;

class SwissMap[K, V] extends HashMap[K, V] {
    def init(hasher : (K) -> i32, eq : (K, K) -> Bool) {
        @store = SwissMapStore[K, V]{hasher, eq};
    }
}

class SwissMapStore[K, V] extends SwissStore[K, V, Pair[K, V]] {
    @keys : Buffer[K]
    @values : Buffer[V]

    regions { @elems_reg == @keys == @values }

    def init(@hasher : (K) -> i32, @eq : (K, K) -> Bool) {
        initial_capacity = 8;
        @keys = Buffer[K].new(initial_capacity);
        @values = Buffer[V].new(initial_capacity);
        @hashes = Buffer[i32].new(initial_capacity);
        @metadata = Buffer[i8].new(initial_capacity);
        @entries_len = initial_capacity;
        @size = 0;
    }

    def value_at(index : i32) -> V {
        return @values.[index];
    }

    def key_at(index : i32) -> K {
        return @keys.[index];
    }

    def set_value_at(index : i32, value : V) {
        @values.[index] = value;
    }

    def set_key_at(index : i32, key : K) {
        @keys.[index] = key;
    }

    def reset_records(capacity : i32) {
        @keys = Buffer[K].new(capacity);
        @values = Buffer[V].new(capacity);
    }

    def resize(new_capacity : i32) {
        old_keys = @keys;
        old_values = @values;
        old_metadata = @metadata;
        old_hashes = @hashes;
        old_len = @entries_len;
        self.reset_records(new_capacity);
        @hashes = Buffer[i32].new(new_capacity);
        @metadata = Buffer[i8].new(new_capacity);
        @entries_len = new_capacity;
        @size = 0;

        for i in 0..old_len {
            if (old_metadata.[i] bit_and occupied_mask()) == 0 { continue; }
            hash = old_hashes.[i];
            slot = self.find_slot_for_new_hash(hash);
            @keys.[slot] = old_keys.[i];
            @values.[slot] = old_values.[i];
            @hashes.[slot] = hash;
            @metadata.[slot] = h2_to_control(hash);
            @size = @size + 1;
        }
    }

    def scan_next(start_cursor : i32) -> Pair[i32, Pair[K, V]]? {
        if start_cursor >= @entries_len { return nil; }

        for cursor in start_cursor..@entries_len {
            if (@metadata.[cursor] bit_and occupied_mask()) == 0 { continue; }
            entry = Pair{@keys.[cursor], @values.[cursor]};
            return Pair{cursor + 1, entry};
        }
        return nil;
    } ~> { ret.second holds @elems_reg }

    def iterator() -> SwissMapStoreIterator[K, V] {
        return SwissMapStoreIterator{self};
    } ~> { ret.store == self }

}

class SwissMapStoreIterator[K, V] extends Iterator[Pair[K, V]] {
    @store : SwissMapStore[K, V]
    @cursor : i32

    regions { @elems_reg == @store.elems_reg }

    def init(@store : SwissMapStore[K, V]) {
        @cursor = 0;
    }

    def next() -> Pair[K, V]? {
        pair = @store.scan_next(@cursor);
        if pair is Nil { return nil; }
        (@cursor, entry) = pair;
        return entry;
    }
}