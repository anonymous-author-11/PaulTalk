import keyed;

class Set[T] extends KeyedStore[T, T, T] {

    abstract def remove(key : T) -> T? ~> { ret holds $values }

    def put(value : T) -> Bool {
        return self.put(value, value);
    } ~> { $values holds value }

    def insert(value : T) -> Bool {
        return self.put(value);
    } ~> { $values holds value }

    def clear() {
        for elem in self { self.remove(elem); }
    } ~> no_alias
}