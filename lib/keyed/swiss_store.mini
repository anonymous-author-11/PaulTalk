import core;
import store;

def empty() -> i8 {
    return 0 as i8;
}

def deleted() -> i8 {
    return -2 as i8;
}

def occupied_mask() -> i8 {
    return 1 as i8;
}

def h2_to_control(hash : i32) -> i8 {
    h2_6bit = (hash >> 26) as i8;
    return (h2_6bit << 1) bit_or occupied_mask();
}

class SwissStore[K, R] extends HashStore[K, R] {
    @hashes : Buffer[i32]
    @metadata : Buffer[i8]
    @entries_len : i32
    @size : i32
    @hasher : (K) -> i32
    @eq : (K, K) -> Bool

    getter @size

    // We abstract from the actual storage of the records
    abstract def record_at(index : i32) -> R {
    } ~> { ret holds @elems_reg }

    abstract def set_record_at(index : i32, record : R) {
    } ~> { @elems_reg holds record }

    abstract def reset_records(capacity : i32) {}

    abstract def resize(new_capacity : i32) {}

    abstract def key_of(record : R) -> K {}

    def hash(key : K) -> i32 {
        return @hasher.call(key);
    }

    def same_key(left : K, right : K) -> Bool {
        return @eq.call(left, right);
    }

    def key_at(index : i32) -> K {
        return self.key_of(self.record_at(index));
    }

    def matches_slot(index : i32, control : i8, key : K, hash : i32, h2_control : i8) -> Bool {
        if control != h2_control { return false; }
        if @hashes.[index] != hash { return false; }
        entry_key = self.key_at(index);
        return self.same_key(entry_key, key);
    }

    def find_slot(key : K, hash : i32) -> i32 {
        capacity = @entries_len;
        mask = capacity - 1;
        start_index = hash bit_and mask;
        h2_control = h2_to_control(hash);
        first_tombstone = -1;

        for probe_offset in 0..capacity {
            index = (start_index + probe_offset) bit_and mask;
            control = @metadata.[index];
            if self.matches_slot(index, control, key, hash, h2_control) { return index; }
            if (control bit_and occupied_mask()) != 0 { continue; }
            is_empty = control == empty();
            if is_empty and first_tombstone != -1 { return first_tombstone; }
            if is_empty { return index; }
            if first_tombstone == -1 { first_tombstone = index; }
        }
        if first_tombstone != -1 { return first_tombstone; }
    }

    def find_slot_for_new_hash(hash : i32) -> i32 {
        capacity = @entries_len;
        mask = capacity - 1;
        start_index = hash bit_and mask;

        for probe_offset in 0..capacity {
            index = (start_index + probe_offset) bit_and mask;
            control = @metadata.[index];
            if (control bit_and occupied_mask()) == 0 { return index; }
        }
    }

    def ensure_capacity(required_size : i32) {
        current_length = @entries_len;
        needs_resize = current_length == 0 or required_size > (current_length * 7) / 8;
        if not needs_resize { return; }
        new_capacity = current_length * 2;
        if new_capacity < 8 { new_capacity = 8; }
        self.resize(new_capacity);
    }

    def get_record(key : K) -> R? {
        if @size == 0 { return nil; }
        hash = self.hash(key);
        index = self.find_slot(key, hash);
        if (@metadata.[index] bit_and occupied_mask()) == 0 { return nil; }
        record = self.record_at(index);
        return record;
    }

    def put_record(record : R) -> R? {
        key = self.key_of(record);
        hash = self.hash(key);
        self.ensure_capacity(@size + 1);
        index = self.find_slot(key, hash);
        was_empty = (@metadata.[index] bit_and occupied_mask()) == 0;

        if not was_empty {
            old_record = self.record_at(index);
            @metadata.[index] = h2_to_control(hash);
            self.set_record_at(index, record);
            @hashes.[index] = hash;
            return old_record;
        }
        
        @metadata.[index] = h2_to_control(hash);
        self.set_record_at(index, record);
        @hashes.[index] = hash;
        @size = @size + 1;
        return nil;
    }

    def remove_record(key : K) -> R? {
        if @size == 0 { return nil; }
        hash = self.hash(key);
        index = self.find_slot(key, hash);
        if (@metadata.[index] bit_and occupied_mask()) == 0 { return nil; }
        record = self.record_at(index);
        @metadata.[index] = deleted();
        @hashes.[index] = 0;
        @size = @size - 1;
        return record;
    }

    def clear() {
        initial_capacity = 8;
        self.reset_records(initial_capacity);
        @hashes = Buffer[i32].new(initial_capacity);
        @metadata = Buffer[i8].new(initial_capacity);
        @entries_len = initial_capacity;
        @size = 0;
    }

    def scan_next(start_cursor : i32) -> Pair[i32, R]? {
        if start_cursor >= @entries_len { return nil; }

        for cursor in start_cursor..@entries_len {
            if (@metadata.[cursor] bit_and occupied_mask()) == 0 { continue; }
            record = self.record_at(cursor);
            return Pair{cursor + 1, record};
        }
        return nil;
    } ~> { ret.second holds @elems_reg }

    def iterator() -> SwissStoreIterator[K, R] {
        return SwissStoreIterator{self};
    } ~> { ret.store == self }
}

class SwissStoreIterator[K, R] extends Iterator[R] {
    @store : SwissStore[K, R]
    @cursor : i32

    regions { @elems_reg == @store.elems_reg }

    def init(@store : SwissStore[K, R]) {
        @cursor = 0;
    }

    def next() -> R? {
        pair = @store.scan_next(@cursor);
        if pair is Nil { return nil; }
        (@cursor, record) = pair;
        return record;
    }
}