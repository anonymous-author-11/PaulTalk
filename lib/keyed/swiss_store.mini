import core;
import store;

def empty() -> i8 {
    return 0 as i8;
}

def deleted() -> i8 {
    return -2 as i8;
}

def occupied_mask() -> i8 {
    return 1 as i8;
}

def group_width() -> i32 {
    return 32;
}

def padding() -> i8 {
    return -1 as i8;
}

def min_capacity() -> i32 {
    return group_width() * 2;
}

def padded_capacity(entries_len : i32) -> i32 {
    return entries_len + group_width();
}

def h2_to_control(hash : i32) -> i8 {
    h2_6bit = (hash >> 26) as i8;
    return (h2_6bit << 1) bit_or occupied_mask();
}

class SwissStore[K, V, T] extends HashStore[K, V, T] {
    @hashes : Buffer[i32]
    @metadata : Buffer[i8]
    @entries_len : i32
    @size : i32
    @hasher : (K) -> i32
    @eq : (K, K) -> Bool

    getter @size

    // We abstract from the actual storage of the records
    abstract def value_at(index : i32) -> V {
    } ~> { ret holds @elems_reg }

    abstract def key_at(index : i32) -> K {
    } ~> { ret holds @elems_reg }

    abstract def set_value_at(index : i32, value : V) {
    } ~> { @elems_reg holds value }

    abstract def set_key_at(index : i32, key : K) {
    } ~> { @elems_reg holds key }

    abstract def reset_records(capacity : i32) {}

    abstract def resize(new_capacity : i32) {}

    abstract def scan_next(start_cursor : i32) -> Pair[i32, T]? {
    } ~> { ret.second holds @elems_reg }

    def hash(key : K) -> i32 {
        return @hasher.call(key);
    }

    def same_key(left : K, right : K) -> Bool {
        return @eq.call(left, right);
    }

    def matches_slot(index : i32, key : K, hash : i32) -> Bool {
        if @hashes.[index] != hash { return false; }
        entry_key = self.key_at(index);
        return self.same_key(entry_key, key);
    }

    def find_slot(key : K, hash : i32) -> i32 {
        mask = @entries_len - 1;
        h2 = h2_to_control(hash);
        probe = hash bit_and mask;
        tombstone = -1;
        metadata = @metadata;

        first_control = metadata.[probe];
        if first_control == empty() { return probe; }
        if first_control == h2 {
            if self.matches_slot(probe, key, hash) { return probe; }
        }

        probe = probe + 1;
        h2_splat = 32 of h2;
        zero_splat = 32 of empty();
        one_splat = 32 of occupied_mask();

        while true {
            group = metadata.[32 from probe];

            h2_matches = group == h2_splat;
            i = cttz(h2_matches);
            while i < group_width() {
                slot = probe + i;
                if self.matches_slot(slot, key, hash) { return slot; }
                h2_matches = blsr(h2_matches);
                i = cttz(h2_matches);
            }

            empty_matches = group == zero_splat;
            i = cttz(empty_matches);
            if i < group_width() {
                if tombstone >= 0 { return tombstone; }
                return probe + i;
            }

            if tombstone < 0 {
                lsb = group bit_and one_splat;
                deleted_matches = lsb == zero_splat;
                i = cttz(deleted_matches);
                if i < group_width() { tombstone = probe + i; }
            }

            probe = (probe + group_width()) bit_and mask;
        }
    }

    def find_slot_for_new_hash(hash : i32) -> i32 {
        mask = @entries_len - 1;
        probe = hash bit_and mask;
        metadata = @metadata;

        if metadata.[probe] == empty() { return probe; }
        probe = probe + 1;

        zero_splat = 32 of empty();
        one_splat = 32 of occupied_mask();

        while true {
            group = metadata.[32 from probe];
            lsb = group bit_and one_splat;
            sentinel_matches = lsb == zero_splat;
            i = cttz(sentinel_matches);
            if i < group_width() { return probe + i; }
            probe = (probe + group_width()) bit_and mask;
        }
    }

    def ensure_capacity(required_size : i32) {
        current_length = @entries_len;
        needs_resize = current_length == 0 or required_size > (current_length * 7) / 8;
        if not needs_resize { return; }
        new_capacity = current_length * 2;
        if new_capacity < min_capacity() { new_capacity = min_capacity(); }
        self.resize(new_capacity);
    }

    def get_value(key : K) -> V? {
        if @size == 0 { return nil; }
        hash = self.hash(key);
        index = self.find_slot(key, hash);
        if (@metadata.[index] bit_and occupied_mask()) == 0 { return nil; }
        return self.value_at(index);
    }

    def put_value(key : K, value : V) -> V? {
        hash = self.hash(key);
        self.ensure_capacity(@size + 1);
        index = self.find_slot(key, hash);
        was_empty = (@metadata.[index] bit_and occupied_mask()) == 0;

        if not was_empty {
            old_value = self.value_at(index);
            @metadata.[index] = h2_to_control(hash);
            self.set_key_at(index, key);
            self.set_value_at(index, value);
            @hashes.[index] = hash;
            return old_value;
        }
        
        @metadata.[index] = h2_to_control(hash);
        self.set_key_at(index, key);
        self.set_value_at(index, value);
        @hashes.[index] = hash;
        @size = @size + 1;
        return nil;
    }

    def remove_value(key : K) -> V? {
        if @size == 0 { return nil; }
        hash = self.hash(key);
        index = self.find_slot(key, hash);
        if (@metadata.[index] bit_and occupied_mask()) == 0 { return nil; }
        value = self.value_at(index);
        @metadata.[index] = deleted();
        @hashes.[index] = 0;
        @size = @size - 1;
        return value;
    }

    def clear() {
        self.reset_table(min_capacity());
    }

    def reset_table(entries_len : i32) {
        capacity = padded_capacity(entries_len);
        self.reset_records(entries_len);
        @hashes = Buffer[i32].new(entries_len);
        @metadata = Buffer[i8].new(capacity);
        @entries_len = entries_len;
        @size = 0;

        for i in entries_len..capacity { @metadata.[i] = padding(); }
    }

    def iterator() -> SwissStoreIterator[K, V, T] {
        return SwissStoreIterator{self};
    } ~> { ret.store == self }

}

class SwissStoreIterator[K, V, T] extends Iterator[T] {
    @store : SwissStore[K, V, T]
    @cursor : i32

    regions { @elems_reg == @store.elems_reg }

    def init(@store : SwissStore[K, V, T]) {
        @cursor = 0;
    }

    def next() -> T? {
        pair = @store.scan_next(@cursor);
        if pair is Nil { return nil; }
        (@cursor, entry) = pair;
        return entry;
    }
}
