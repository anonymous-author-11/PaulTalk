import core;
import keyed.map;

def empty() -> i8 {
    return 0 as i8;
}

def deleted() -> i8 {
    return -2 as i8;
}

def occupied_mask() -> i8 {
    return 1 as i8;
}

class SwissMap[K, V] extends Map[K, V] {
    @keys : Buffer[K]
    @values : Buffer[V]
    @hashes : Buffer[i32]
    @metadata : Buffer[i8]
    @entries_len : i32
    @size : i32
    @hasher : (K) -> i32
    @eq : (K, K) -> Bool

    regions { @elems_reg == @keys == @values }

    getter @size

    def init(@hasher : (K) -> i32, @eq : (K, K) -> Bool) {
        initial_capacity = 8;
        @keys = Buffer[K].new(initial_capacity);
        @values = Buffer[V].new(initial_capacity);
        @hashes = Buffer[i32].new(initial_capacity);
        @metadata = Buffer[i8].new(initial_capacity);
        @entries_len = initial_capacity;
        @size = 0;
    }

    def hash(key : K) -> i32 {
        return @hasher.call(key);
    }

    def same_key(left : K, right : K) -> Bool {
        return @eq.call(left, right);
    }

    def Self.h2_to_control(hash : i32) -> i8 {
        h2_6bit = (hash >> 26) as i8;
        return (h2_6bit << 1) bit_or occupied_mask();
    }

    def matches_slot(index : i32, control : i8, key : K, hash : i32, h2_control : i8) -> Bool {
        if control != h2_control { return false; }
        if @hashes.[index] != hash { return false; }
        slot_key = @keys.[index];
        return self.same_key(slot_key, key);
    }

    def find_slot(key : K, hash : i32) -> i32 {
        capacity = @entries_len;
        mask = capacity - 1;
        start_index = hash bit_and mask;
        h2_control = Self.h2_to_control(hash);
        first_tombstone = -1;

        for probe_offset in 0..capacity {
            index = (start_index + probe_offset) bit_and mask;
            control = @metadata.[index];
            if self.matches_slot(index, control, key, hash, h2_control) { return index; }
            if (control bit_and occupied_mask()) != 0 { continue; }
            is_empty = control == empty();
            if is_empty and first_tombstone != -1 { return first_tombstone; }
            if is_empty { return index; }
            if first_tombstone == -1 { first_tombstone = index; }
        }
        if first_tombstone != -1 { return first_tombstone; }
    }

    def find_slot_for_new_hash(hash : i32) -> i32 {
        capacity = @entries_len;
        mask = capacity - 1;
        start_index = hash bit_and mask;

        for probe_offset in 0..capacity {
            index = (start_index + probe_offset) bit_and mask;
            control = @metadata.[index];
            if (control bit_and occupied_mask()) == 0 { return index; }
        }
    }

    def resize(new_capacity : i32) {
        old_keys = @keys;
        old_values = @values;
        old_hashes = @hashes;
        old_metadata = @metadata;
        old_len = @entries_len;

        @keys = Buffer[K].new(new_capacity);
        @values = Buffer[V].new(new_capacity);
        @hashes = Buffer[i32].new(new_capacity);
        @metadata = Buffer[i8].new(new_capacity);
        @entries_len = new_capacity;
        @size = 0;

        for i in 0..old_len {
            if (old_metadata.[i] bit_and occupied_mask()) == 0 { continue; }
            hash = old_hashes.[i];
            slot = self.find_slot_for_new_hash(hash);
            @keys.[slot] = old_keys.[i];
            @values.[slot] = old_values.[i];
            @hashes.[slot] = hash;
            @metadata.[slot] = Self.h2_to_control(hash);
            @size = @size + 1;
        }
    }

    def ensure_capacity(required_size : i32) {
        current_length = @entries_len;
        needs_resize = current_length == 0 or required_size > (current_length * 7) / 8;
        if not needs_resize { return; }
        new_capacity = current_length * 2;
        if new_capacity < 8 { new_capacity = 8; }
        self.resize(new_capacity);
    }

    def get(key : K) -> V? {
        if @size == 0 { return nil; }
        hash = self.hash(key);
        index = self.find_slot(key, hash);
        if (@metadata.[index] bit_and occupied_mask()) == 0 { return nil; }
        value = @values.[index];
        return value;
    }

    def insert(key : K, value : V) {
        hash = self.hash(key);
        self.ensure_capacity(@size + 1);
        index = self.find_slot(key, hash);
        was_empty = (@metadata.[index] bit_and occupied_mask()) == 0;
        @metadata.[index] = Self.h2_to_control(hash);
        @keys.[index] = key;
        @values.[index] = value;
        @hashes.[index] = hash;
        if was_empty { @size = @size + 1; }
    }

    def remove(key : K) -> V? {
        if @size == 0 { return nil; }
        hash = self.hash(key);
        index = self.find_slot(key, hash);
        if (@metadata.[index] bit_and occupied_mask()) == 0 { return nil; }
        value = @values.[index];
        @metadata.[index] = deleted();
        @hashes.[index] = 0;
        @size = @size - 1;
        return value;
    }

    def clear() {
        initial_capacity = 8;
        @keys = Buffer[K].new(initial_capacity);
        @values = Buffer[V].new(initial_capacity);
        @hashes = Buffer[i32].new(initial_capacity);
        @metadata = Buffer[i8].new(initial_capacity);
        @entries_len = initial_capacity;
        @size = 0;
    }

    def scan_next(start_cursor : i32) -> Pair[i32, Pair[K, V]]? {
        if start_cursor >= @entries_len { return nil; }

        for cursor in start_cursor..@entries_len {
            if (@metadata.[cursor] bit_and occupied_mask()) == 0 { continue; }
            key = @keys.[cursor];
            value = @values.[cursor];
            return Pair{cursor + 1, Pair{key, value}};
        }
        return nil;
    } ~> { ret.second holds @elems_reg }

    def iterator() -> SwissMapIterator[K, V] {
        return SwissMapIterator{self};
    } ~> { ret.map == self }
}

class SwissMapIterator[K, V] extends Iterator[Pair[K, V]] {
    @map : SwissMap[K, V]
    @cursor : i32

    regions { @elems_reg == @map.elems_reg }

    def init(@map : SwissMap[K, V]) {
        @cursor = 0;
    }

    def next() -> Pair[K, V]? {
        pair = @map.scan_next(@cursor);
        if pair is Nil { return nil; }
        (@cursor, entry) = pair;
        return entry;
    }
}
