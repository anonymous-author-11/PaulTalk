import core;
import array;

no_export AbsolutePath, RelativePath, PathBuilder, AbsolutePathBuilder, RelativePathBuilder;

class Path extends Representable {
    @source : String
    @segments : Array[StringView]

    def Self.new(text : String) -> Path {
        string = text.replace("\\", "/");
        if string.starts_with("/") { return AbsolutePath{string}; }
        return RelativePath{string};
    }

    def Self.stem_of(base : StringView) -> StringView {
        if base == ".." { return base; }
        pair = base.bytes().rsplit_once(".");
        if pair is Nil { return base; }
        (before, after) = pair;
        if before.is_empty() { return base; }
        return before.to_string_view();
    }

    abstract def dirname() -> Path {}
    abstract def slow_join(child : Path) -> Path {}
    abstract def fast_join(all_parts : Array[StringView]) -> Path {}
    
    def is_absolute() -> Bool {
        return self is AbsolutePath;
    }

    def components() -> Collection[StringView] {
        return @segments;
    }

    def basename() -> StringView {
        last = @segments.last();
        if last is StringView { return last; }
        return @source.to_view(); // "/" for absolute, "." for relative
    }

    def stem() -> StringView {
        return Path.stem_of(self.basename());
    }

    def extension() -> StringView? {
        base = self.basename();
        if base == ".." { return nil; }
        pair = base.bytes().rsplit_once(".");
        if pair is Nil { return nil; }
        (before, after) = pair;
        if before.is_empty() or after.is_empty() { return nil; }
        return after.to_string_view();
    }

    def parent() -> Path {
        return self.dirname();
    }

    def join(child : Path) -> Path {
        child_parts = child.components();
        first = child_parts.first();
        if first is StringView and first == ".." { return self.slow_join(child); }
        all_parts = @segments.copy().extend(child_parts);
        return self.fast_join(all_parts);
    }

    def join(child : String) -> Path {
        return self.join(Path{child});
    }

    def with_extension(ext : String) -> Path {
        if @segments.is_empty() { return self; }
        base = self.basename();
        if base == ".." { return self; }
        stem = Path.stem_of(base);
        if not ext.is_empty() and not ext.starts_with(".") { ext = ".${ext}"; }
        new_base = "${stem.to_string()}${ext}";
        return self.dirname().join(new_base);
    }

    def join(child : AbsolutePath) -> AbsolutePath {
        return child;
    }

    def to_string() -> String {
        return @source.copy();
    }

    def repr() -> String {
        return self.to_string();
    }
}

class AbsolutePath extends Path {

    // Override the factory to delegate to .init
    def Self.new(text : String) -> Self {
        return Self{text};
    }

    // input array is now "owned" by the returned instance
    // we assume none of the input views are empty
    def Self.from_views(views : Array[StringView]) -> AbsolutePath {
        if views.is_empty() { return AbsolutePath{"/", [] of StringView}; }
        str_parts = views.map((v : StringView) => { v.to_string(); });
        joined = "/".join(str_parts);
        return AbsolutePath{"/${joined}", views};
    }

    def init(@source : String, @segments : Array[StringView]) {}

    // we store views into the raw input string and this is totally fine
    def init(raw : String) {
        built = AbsolutePathBuilder{raw}.build();
        @source = built.str();
        @segments = built.parts();
    } ~> all_alias

    def is_absolute() -> Bool {
        return true;
    }

    def dirname() -> Path {
        if @segments.is_empty() { return self; }
        if @segments.size() == 1 { return AbsolutePath{"/", [] of StringView}; }
        parent_views = @segments.copy();
        parent_views.pop();
        return AbsolutePath.from_views(parent_views);
    }

    def fast_join(all_parts : Array[StringView]) -> Path {
        return AbsolutePath.from_views(all_parts);
    }

    def slow_join(child : Path) -> Path {
        return AbsolutePath{"${@source}/${child.to_string()}"};
    }

}

class RelativePath extends Path {

    // Override the factory to delegate to .init
    def Self.new(text : String) -> Self {
        return Self{text};
    }

    // input array is now "owned" by the returned instance
    // we assume none of the input views are empty
    def Self.from_views(views : Array[StringView]) -> RelativePath {
        if views.is_empty() { return RelativePath{".", [] of StringView}; }
        parts = views.map((v : StringView) => { v.to_string(); });
        return RelativePath{"/".join(parts), views};
    }

    def init(@source : String, @segments : Array[StringView]) {}

    // we store views into the raw input string and this is totally fine
    def init(raw : String) {
        built = RelativePathBuilder{raw}.build();
        @source = built.str();
        @segments = built.parts();
    } ~> all_alias

    def dirname() -> Path {
        if @segments.is_empty() { return self; }
        if @segments.size() == 1 { return RelativePath{".", [] of StringView}; }
        parent_views = @segments.copy();
        parent_views.pop();
        return RelativePath.from_views(parent_views);
    }

    def fast_join(all_parts : Array[StringView]) -> Path {
        return RelativePath.from_views(all_parts);
    }

    def slow_join(child : Path) -> Path {
        return RelativePath{"${@source}/${child.to_string()}"};
    }

}

class PathBuilder {
    @str : String
    @parts : Array[StringView]

    getters @str, @parts

    abstract def add_double_dot(part : StringView) {}
    abstract def empty_str() -> String {}
    abstract def joined_str(joined : String) -> String {}

    def init(@str : String) {
        @parts = [] of StringView;
    }

    def build() -> Self {
        for part in @str.split("/") { self.add_part(part); }

        if @parts.is_empty() {
            @str = self.empty_str();
            return self;
        }
        str_parts = @parts.map((v : StringView) => { v.to_string(); });
        joined = "/".join(str_parts);
        @str = self.joined_str(joined);
        return self;
    }

    def add_part(part : StringView) {
        if part.is_empty() or part == "." { return; }
        if part != ".." {
            @parts.push(part);
            return;
        }
        self.add_double_dot(part);
    }
}

class AbsolutePathBuilder extends PathBuilder {

    def empty_str() -> String {
        return "/";
    }

    def joined_str(joined : String) -> String {
        return "/${joined}";
    }

    def add_double_dot(part : StringView) {
        if @parts.is_empty() { return; }
        @parts.pop();
    }
}

class RelativePathBuilder extends PathBuilder {

    def empty_str() -> String {
        return ".";
    }

    def joined_str(joined : String) -> String {
        return joined;
    }

    def add_double_dot(part : StringView) {
        last = @parts.last();
        if last is Nil or last == ".." {
            @parts.push(part);
            return;
        }
        @parts.pop();
    }
}