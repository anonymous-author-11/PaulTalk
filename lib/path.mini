import core;

class Path extends Representable {
    @text : String

    // Path keeps normalized internal text so queries stay simple.
    def init(text : String) {
        @text = Self.normalize_text(text);
    }

    def Self.from_string(text : String) -> Self {
        return Self{text};
    }

    def Self.append_part(text : String, part : String) -> String {
        if text.is_empty() { return part.copy(); }
        if text == "/" { return "/${part}"; }
        return "${text}/${part}";
    }

    def Self.trim_last_part(text : String) -> String {
        pair = text.rsplit_once("/");
        if pair is Nil { return ""; }
        return pair.[0].to_string();
    }

    def Self.basename_of(text : String) -> String {
        sep = "/";
        if text == sep { return sep; }
        if text == "." { return "."; }
        pair = text.rsplit_once(sep);
        if pair is Nil { return text.copy(); }
        return pair.[1].to_string();
    }

    def Self.stem_of(base : String) -> String {
        if base == ".." { return base.copy(); }
        pair = base.rsplit_once(".");
        if pair is Nil { return base.copy(); }
        (stem, after) = pair;
        if stem.is_empty() { return base.copy(); }
        return stem.to_string();
    }

    def Self.add_part(text : String, part : String, absolute : Bool) -> String {
        if part.is_empty() or part == "." { return text; }
        if part != ".." { return Self.append_part(text, part); }
        if text.is_empty() and absolute { return text; }
        if text.is_empty() { return ".."; }
        if text == "/" { return text; }

        if Self.basename_of(text) != ".." { return Self.trim_last_part(text); }
        return Self.append_part(text, "..");
    }

    def Self.normalize_text(input : String) -> String {
        unified = input.replace("\\", "/");
        absolute = unified.starts_with("/");
        text = "";
        if absolute { text = "/"; }

        for part in unified.split("/") {
            text = Self.add_part(text, part.to_string(), absolute);
        }
        if text.is_empty() { return "."; }
        return text;
    } ~> no_alias

    def to_string() -> String {
        return @text.copy();
    }

    def components() -> Iterable[StringView] {
        return @text.split("/")
            .filter((part : StringView) => { part.byte_length() > 0; });
    }

    def basename() -> String {
        return Self.basename_of(@text);
    }

    def dirname() -> Path {
        if @text == "/" or @text == "." { return self; }

        parent = Self.trim_last_part(@text);
        if parent.is_empty() { return Path{"."}; }
        return Path{parent};
    }

    def repr() -> String {
        return self.to_string();
    }

    def is_absolute() -> Bool {
        return @text.starts_with("/");
    }

    def parent() -> Path {
        return self.dirname();
    }

    def join(child : Path) -> Path {
        if child.is_absolute() { return child; }

        child_text = child.to_string();
        if child_text == "." { return self; }

        text = @text;
        absolute = text.starts_with("/");
        if text == "." { text = ""; }

        for part in child_text.split("/") {
            text = Self.add_part(text, part.to_string(), absolute);
        }
        if text.is_empty() { return Path{"."}; }
        return Path{text};
    }

    def join(child : String) -> Path {
        return self.join(Path{child});
    }

    def stem() -> String {
        return Self.stem_of(self.basename());
    }

    def extension() -> String? {
        base = self.basename();
        pair = base.rsplit_once(".");
        if pair is Nil { return nil; }
        (before, extension) = pair;
        if before.is_empty() or extension.is_empty() { return nil; }
        return extension.to_string();
    }

    def with_extension(ext : String) -> Path {
        base = Self.basename_of(@text);
        if base == "." or base == ".." or base == "/" { return self; }

        suffix = ext;
        if suffix.byte_length() > 0 and not suffix.starts_with(".") {
            suffix = ".${suffix}";
        }

        name = Self.stem_of(base).extend(suffix);
        parent = Self.trim_last_part(@text);
        if parent.is_empty() { return Path{name}; }
        return Path{Self.append_part(parent, name)};
    }
}
