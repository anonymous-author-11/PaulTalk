import core;

class Path extends Representable {
    @text : String

    // Path keeps normalized internal text so queries stay simple.
    def init(text : String) {
        @text = Self.normalize_text(text);
    }

    def Self.from_string(text : String) -> Self {
        return Self{text};
    }

    def Self.separator() -> String {
        return "/";
    }

    def Self.separator_byte() -> i8 {
        return '/' as i8;
    }

    def Self.alt_separator_byte() -> i8 {
        return '\\' as i8;
    }

    def Self.unify_separators(input : String) -> String {
        out = String{input.byte_length()};
        writer = out.bytes().writer();
        for byte in input.bytes() {
            out_byte = byte;
            if byte == Self.alt_separator_byte() { out_byte = Self.separator_byte(); }
            writer.write(out_byte);
        }
        out.increment_chars(input.char_length());
        return out;
    } ~> no_alias

    def Self.is_absolute_text(text : String) -> Bool {
        if text.byte_length() == 0 { return false; }
        return text.unchecked_index(0) == Self.separator_byte();
    }

    def Self.last_index_of_byte(source : String, target : i8) -> i32? {
        index = 0;
        found = nil;
        for byte in source.bytes() {
            if byte == target { found = index; }
            index = index + 1;
        }
        return found;
    } ~> no_alias

    def Self.append_part(text : String, part : String) -> String {
        if text.byte_length() == 0 { return part.copy(); }
        if text == Self.separator() { return "/${part}"; }
        return "${text}/${part}";
    }

    def Self.trim_last_part(text : String) -> String {
        slash = Self.last_index_of_byte(text, Self.separator_byte());
        if slash is not i32 { return ""; }
        if slash == 0 { return Self.separator(); }
        return text.slice_bytes(0, slash);
    }

    def Self.basename_of(text : String) -> String {
        if text == Self.separator() { return Self.separator(); }
        if text == "." { return "."; }
        slash = Self.last_index_of_byte(text, Self.separator_byte());
        if slash is not i32 { return text.copy(); }
        return text.slice_bytes(slash + 1, text.byte_length());
    }

    def Self.is_special_name(name : String) -> Bool {
        return name == "." or name == ".." or name == Self.separator();
    }

    def Self.extension_index(base : String) -> i32? {
        if Self.is_special_name(base) { return nil; }

        dot = Self.last_index_of_byte(base, '.' as i8);
        if dot is not i32 { return nil; }
        if dot == 0 { return nil; }
        if dot == base.byte_length() - 1 { return nil; }
        return dot;
    }

    def Self.stem_of(base : String) -> String {
        dot = Self.extension_index(base);
        if dot is not i32 { return base.copy(); }
        return base.slice_bytes(0, dot);
    }

    def Self.add_part(text : String, part : String, absolute : Bool) -> String {
        if part.byte_length() == 0 or part == "." { return text; }
        if part == ".." {
            if text.byte_length() == 0 and absolute { return text; }
            if text.byte_length() == 0 { return ".."; }
            if text == Self.separator() { return text; }

            tail = Self.basename_of(text);
            if tail == ".." { return Self.append_part(text, ".."); }
            return Self.trim_last_part(text);
        }
        return Self.append_part(text, part);
    }

    def Self.normalize_text(input : String) -> String {
        unified = Self.unify_separators(input);
        absolute = Self.is_absolute_text(unified);
        text = "";
        if absolute { text = Self.separator(); }

        for part in unified.split(Self.separator()) {
            text = Self.add_part(text, part.to_string(), absolute);
        }
        if text.byte_length() == 0 { return "."; }
        return text;
    } ~> no_alias

    def to_string() -> String {
        return @text.copy();
    }

    def components() -> Iterable[StringView] {
        return @text.split(Self.separator())
            .filter((part : StringView) => { part.byte_length() > 0; });
    }

    def basename() -> String {
        return Self.basename_of(@text);
    }

    def dirname() -> Path {
        if @text == Self.separator() { return self; }
        if @text == "." { return self; }

        parent = Self.trim_last_part(@text);
        if parent.byte_length() == 0 { return Path{"."}; }
        return Path{parent};
    }

    def repr() -> String {
        return self.to_string();
    }

    def is_absolute() -> Bool {
        return Self.is_absolute_text(@text);
    }

    def parent() -> Path {
        return self.dirname();
    }

    def join(child : Path) -> Path {
        if child.is_absolute() { return child; }

        child_text = child.to_string();
        if child_text == "." { return self; }

        text = @text;
        absolute = Self.is_absolute_text(text);
        if text == "." { text = ""; }

        for part in child_text.split(Self.separator()) {
            text = Self.add_part(text, part.to_string(), absolute);
        }
        if text.byte_length() == 0 { return Path{"."}; }
        return Path{text};
    }

    def join(child : String) -> Path {
        return self.join(Path{child});
    }

    def stem() -> String {
        return Self.stem_of(self.basename());
    }

    def extension() -> String? {
        base = self.basename();
        dot = Self.extension_index(base);
        if dot is not i32 { return nil; }
        return base.slice_bytes(dot, base.byte_length());
    }

    def with_extension(ext : String) -> Path {
        base = Self.basename_of(@text);
        if Self.is_special_name(base) { return self; }

        suffix = ext;
        if suffix.byte_length() > 0 and not suffix.starts_with(".") {
            suffix = ".${suffix}";
        }

        name = Self.stem_of(base).extend(suffix);
        parent = Self.trim_last_part(@text);
        if parent.byte_length() == 0 { return Path{name}; }
        return Path{Self.append_part(parent, name)};
    }
}
