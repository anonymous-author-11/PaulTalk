import stacktrace;
import string;

no_export string;
no_export stacktrace;

class Exception {
    @line_number : i32
    @file_name : String
    @message : String
    @stacktrace : Stacktrace

    def init(@message : String) {
        @line_number = 0;
        @file_name = "";
        @stacktrace = Stacktrace{};
    }
    def init() {
        @line_number = 0;
        @message = "<None>";
        @file_name = "";
        @stacktrace = Stacktrace{};
    }

    def message() -> String {
        return @message;
    }

    def set_info(@line_number : i32, @file_name : String) {}

    def report() {
        print(
            "---------\n"
            .extend("Exception thrown from file ${@file_name}")
            .extend(" at line ${@line_number} with message")
            .extend("\n\n${self.message()}\n\nStack trace:\n")
        );
        @stacktrace.print();
        print("---------");
    }
}

class InvalidUnicodeError extends Exception {
    def init() {
        @message = "Invalid unicode sequence encountered.";
        @line_number = 0;
        @file_name = "";
        @stacktrace = Stacktrace{};
    }
}

class InvalidSliceRange extends Exception {
    def init() {
        @message = "Slice range must be contiguous and increasing by 1.";
        @line_number = 0;
        @file_name = "";
        @stacktrace = Stacktrace{};
    }
}

class OutOfBounds extends Exception {
    @details : OutOfBoundsDetails?

    def init(bounds : i32, index : i32) {
        @details = OutOfBoundsDetails{bounds, index};
        @line_number = 0;
        @file_name = "";
        @message = "An out-of-bounds error occurred while indexing into a collection.";
        @stacktrace = Stacktrace{};
    }
    def message() -> String {
        details = @details;
        if details is Nil { return @message; }
        return "${@message}\n${details.report()}";
    }
}

class OutOfBoundsDetails {
    @bounds : i32
    @index : i32

    def init(@bounds : i32, @index : i32) {}

    def report() -> String {
        return "The size of the collection being indexed was ${@bounds}"
            .extend("\nThe indexing argument was ${@index}");
    }
}

def report_exception(current_coroutine : Coroutine[() -> Exception]) {
    exception = current_coroutine.result();
    if exception is Nil { return; }
    exception.report();
}