import queue;

class CircleQueue[T] extends IndexedStore[T], Queue[T] {
    @buffer : Buffer[T]
    @head : i32
    @count : i32
    @capacity : i32

    regions { $elems == @buffer }

    def Self.empty() -> Self { return Self{}; }

    def Self.from_iterable(iterable : Iterable[T]) -> Self {
        return Self.empty().extend(iterable);
    }

    def init() {
        @buffer = Buffer[T].new(1);
        @head = 0;
        @count = 0;
        @capacity = 1;
    }

    def size() -> i32 { return @count; }

    def append(x : T) -> Self {
        if @count >= @capacity { self.grow(); }
        tail = (@head + @count) bit_and (@capacity - 1);
        @buffer.[tail] = x;
        @count = @count + 1;
        return self;
    }

    def dequeue() -> T? {
        if @count == 0 { return nil; }
        head = @head;
        @head = (head + 1) bit_and (@capacity - 1);
        @count = @count - 1;
        return @buffer.[head];
    }

    def clear() {
        @head = 0;
        @count = 0;
    }

    def get_unchecked(canonical_index : i32) -> T {
        physical = (@head + canonical_index) bit_and (@capacity - 1);
        return @buffer.[physical];
    }

    def put_unchecked(canonical_index : i32, value : T) {
        physical = (@head + canonical_index) bit_and (@capacity - 1);
        @buffer.[physical] = value;
    }

    def grow() {
        new_capacity = @capacity * 2;
        new_buffer = Buffer[T].new(new_capacity);
        for i in 0..@count { new_buffer.[i] = self.get_unchecked(i); }
        @buffer = new_buffer;
        @head = 0;
        @capacity = new_capacity;
    } ~> no_alias

}