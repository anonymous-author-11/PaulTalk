import queue;

class CircleQueue[T] extends Queue[T], IndexableCollection[i32, T, T] {
    @buffer : Buffer[T]
    @head : i32
    @count : i32
    @capacity : i32

    regions { @elems_reg == @buffer }

    def Self.empty() -> Self { return Self{}; }

    def Self.from_iterable(iterable : Iterable[T]) -> Self {
        return Self.empty().extend(iterable);
    }

    def init() {
        @buffer = Buffer[T].new(1);
        @head = 0;
        @count = 0;
        @capacity = 1;
    }

    def size() -> i32 {
        return @count;
    }

    def append(x : T) -> Self {
        if @count >= @capacity { self.grow(); }
        tail = (@head + @count) bit_and (@capacity - 1);
        @buffer.[tail] = x;
        @count = @count + 1;
        return self;
    }

    def dequeue() -> T? {
        if @count == 0 { return nil; }
        head = @head;
        @head = (head + 1) bit_and (@capacity - 1);
        @count = @count - 1;
        return @buffer.[head];
    }

    def first() -> T? {
        if @count == 0 { return nil; }
        return @buffer.[@head];
    }

    def last() -> T? {
        if @count == 0 { return nil; }
        tail = (@head + @count - 1) bit_and (@capacity - 1);
        return @buffer.[tail];
    }

    def clear() -> Self {
        @head = 0;
        @count = 0;
        return self;
    }

    def indices() -> Range {
        return 0..@count;
    }

    def values() -> Self {
        return self;
    }

    def [](index : i32) -> T yields OutOfBounds {
        self.bounds_check(index);
        if index < 0 { index = @count + index; }
        return self.unchecked_index(index);
    }

    def []=(index : i32, value : T) yields OutOfBounds {
        self.bounds_check(index);
        if index < 0 { index = @count + index; }
        self.unchecked_insert(index, value);
    }

    def bounds_check(index : i32) yields OutOfBounds {
        past_end = index > (@count - 1);
        before_start = (@count + index) < 0;
        if past_end or before_start {
            yield(OutOfBounds{@count, index});
        }
    }

    def unchecked_index(index : i32) -> T {
        physical = (@head + index) bit_and (@capacity - 1);
        return @buffer.[physical];
    } ~> { ret holds @elems_reg }

    def unchecked_insert(index : i32, value : T) {
        physical = (@head + index) bit_and (@capacity - 1);
        @buffer.[physical] = value;
    } ~> { @elems_reg holds value }

    def grow() {
        new_capacity = @capacity * 2;
        new_buffer = Buffer[T].new(new_capacity);
        for i in 0..@count { new_buffer.[i] = self.unchecked_index(i); }
        @buffer = new_buffer;
        @head = 0;
        @capacity = new_capacity;
    } ~> no_alias

    def iterator() -> ConstantTimeIterator[T] {
        return CircleQueueIterator{self};
    }
}

class CircleQueueIterator[T] extends ConstantTimeIterator[T] {
    @queue : CircleQueue[T]
    @index : i32

    regions { @elems_reg == @queue.elems_reg }

    def init(@queue : CircleQueue[T]) {
        @index = 0;
    }

    def next() -> T? {
        if @index >= @queue.size() { return nil; }
        index = @index;
        @index = index + 1;
        return @queue.unchecked_index(index);
    }
}
