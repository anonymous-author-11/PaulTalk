import io;
import path;
import list;

// Spawn modes for stdin/stdout/stderr: 0=inherit, 1=discard, 2=pipe.
//
// Linux/macOS: posix_spawn or fork+execvp; mode 1 dup2's /dev/null;
//              mode 2 creates pipe(); parent end exposed as channel ID.
// Windows:     CreateProcessW; mode 1 opens "NUL"; mode 2 creates an
//              anonymous pipe via CreatePipe.
extern def process_spawn(
    program     : Buffer[i8],
    argv        : Buffer[Buffer[i8]],
    argc        : i32,
    envp        : Buffer[Buffer[i8]],
    envc        : i32,
    inherit_env : i32,
    cwd         : Buffer[i8],
    stdin_mode  : i32,
    stdout_mode : i32,
    stderr_mode : i32,
    out_handle  : Buffer[i64],
    out_chans   : Buffer[i32]
) -> i32

// Linux/macOS: waitpid(); decode WIFEXITED / WIFSIGNALED.
// Windows:     WaitForSingleObject + GetExitCodeProcess; structured-
//              exception codes (>= 0xC0000000) reported as abnormal.
extern def process_wait(
    handle     : i64,
    out_code   : Buffer[i32],
    out_killed : Buffer[i32]
) -> i32

extern def process_try_wait(
    handle     : i64,
    out_code   : Buffer[i32],
    out_killed : Buffer[i32],
    out_done   : Buffer[i32]
) -> i32

// Graceful: kill(SIGTERM) / GenerateConsoleCtrlEvent(CTRL_BREAK).
extern def process_terminate(handle : i64) -> i32
// Forceful: kill(SIGKILL) / TerminateProcess.
extern def process_kill(handle : i64) -> i32
// Reap / CloseHandle after wait.
extern def process_release(handle : i64) -> i32

// Channel I/O. Channel IDs are abstract; runtime maps to fd / HANDLE.
extern def channel_read(chan : i32, buf : Buffer[i8], n : i64) -> i64
extern def channel_write(chan : i32, bytes : Buffer[i8], n : i64) -> i64
extern def channel_close(chan : i32) -> i32

// Spawn + multiplexed drain + wait, atomically. Implemented by the
// runtime with poll() / WaitForMultipleObjects so no language-level
// concurrency is needed for the common "run and capture" case.
// Allocates the returned out_stdout / out_stderr buffers.
extern def process_run_capture(
    program          : Buffer[i8],         // null-terminated executable path
    argv             : Buffer[Buffer[i8]], // args; runtime prepends program as argv[0]
    argc             : i32,
    envp             : Buffer[Buffer[i8]], // "KEY=VALUE" strings
    envc             : i32,
    inherit_env      : i32,                // 1 = merge with parent env, 0 = envp only
    cwd              : Buffer[i8],         // null-terminated; empty = inherit
    stdin_data       : Buffer[i8],
    stdin_len        : i64,
    capture_stdout   : i32,
    capture_stderr   : i32,
    out_stdout       : Buffer[Buffer[i8]],
    out_stdout_len   : Buffer[i64],
    out_stderr       : Buffer[Buffer[i8]],
    out_stderr_len   : Buffer[i64],
    out_code         : Buffer[i32],
    out_killed       : Buffer[i32]
) -> i32

class SubprocessError extends Exception {
    def init() {
        @message = "Subprocess operation failed.";
        @line_number = 0; @file_name = ""; @stacktrace = Stacktrace{};
    }
    def init(@message : String) {
        @line_number = 0; @file_name = ""; @stacktrace = Stacktrace{};
    }
}

class ExitStatus {
    @code   : i32
    @killed : Bool

    getters @code, @killed

    def init(@code : i32, @killed : Bool) {}

    def ok() -> Bool { return not @killed and @code == 0; }
}

class Output {
    @stdout : String
    @stderr : String
    @status : ExitStatus

    getters @stdout, @stderr, @status

    def init(@stdout : String, @stderr : String, @status : ExitStatus) {}

    def ok()   -> Bool { return @status.ok(); }
    def code() -> i32  { return @status.code(); }
}

class PipeIn extends Writer[i8] {
    @chan    : i32
    @open    : Bool
    @scratch : Buffer[i8]

    regions { $dest holds @chan }

    def init(@chan : i32) {
        @open = true;
        @scratch = Buffer[i8].new(1);
    }

    def write(value : i8) {
        if not @open { yield(SubprocessError{"pipe closed"}); }
        @scratch.[0] = value;
        n = channel_write(@chan, @scratch, 1 as i64);
        if n < 1 as i64 { yield(SubprocessError{"channel_write failed"}); }
    }

    def write_from(source : Collection[i8], max_elems : i32) -> i32 {
        n = source.size();
        if max_elems < n { n = max_elems; }
        buf = Buffer[i8].new(n);
        for (i, b) in source.enumerate() {
            if i >= n { break; }
            buf.[i] = b;
        }
        wrote = channel_write(@chan, buf, n as i64);
        if wrote < 0 as i64 { yield(SubprocessError{"channel_write failed"}); }
        return wrote as i32;
    }

    def close() {
        if not @open { return; }
        @open = false;
        if channel_close(@chan) != 0 {
            yield(SubprocessError{"channel_close failed"});
        }
    }
}

class PipeOut extends Iterator[i8] {
    @chan     : i32
    @buf      : Buffer[i8]
    @capacity : i32
    @len      : i32
    @cursor   : i32
    @eof      : Bool

    regions { $elems holds @chan }

    def init(@chan : i32) {
        @capacity = 8192;
        @buf = Buffer[i8].new(@capacity);
        @len = 0; @cursor = 0; @eof = false;
    }

    def refill() {
        @cursor = 0; @len = 0;
        n = channel_read(@chan, @buf, @capacity as i64);
        if n < 0 as i64 { yield(SubprocessError{"channel_read failed"}); }
        if n == 0 as i64 { @eof = true; return; }
        @len = n as i32;
    } 

    def next() -> i8? {
        if @cursor >= @len {
            if @eof { return nil; }
            self.refill();
            if @len == 0 { return nil; }
        }
        b = @buf.[@cursor];
        @cursor = @cursor + 1;
        return b;
    }

    def close() {
        if channel_close(@chan) != 0 {
            yield(SubprocessError{"channel_close failed"});
        }
    }
}

class Process {
    @handle : i64
    @stdin  : PipeIn?
    @stdout : PipeOut?
    @stderr : PipeOut?
    @status : ExitStatus?

    getters @stdin, @stdout, @stderr

    def init(@handle : i64, @stdin : PipeIn?, @stdout : PipeOut?, @stderr : PipeOut?) {
        @status = nil;
    }

    def wait() -> ExitStatus {
        cached = @status;
        if cached is ExitStatus { return cached; }
        code   = Buffer[i32].new(1);
        killed = Buffer[i32].new(1);
        if process_wait(@handle, code, killed) != 0 {
            yield(SubprocessError{"wait failed"});
        }
        result = ExitStatus{code.[0], killed.[0] == 1};
        @status = result;
        process_release(@handle);
        return result;
    } 

    def try_wait() -> ExitStatus? {
        cached = @status;
        if cached is ExitStatus { return cached; }
        code   = Buffer[i32].new(1);
        killed = Buffer[i32].new(1);
        done   = Buffer[i32].new(1);
        if process_try_wait(@handle, code, killed, done) != 0 {
            yield(SubprocessError{"try_wait failed"});
        }
        if done.[0] == 0 { return nil; }
        result = ExitStatus{code.[0], killed.[0] == 1};
        @status = result;
        process_release(@handle);
        return result;
    } 

    def terminate() {
        if process_terminate(@handle) != 0 { yield(SubprocessError{"terminate failed"}); }
    }
    def kill() {
        if process_kill(@handle) != 0 { yield(SubprocessError{"kill failed"}); }
    }

    def close() {
        if @status is ExitStatus { return; }
        process_kill(@handle);
        code   = Buffer[i32].new(1);
        killed = Buffer[i32].new(1);
        process_wait(@handle, code, killed);
        process_release(@handle);
    }
}

class Command {
    @program     : String
    @args        : Collection[String]
    @env         : List[Pair[String, String]]
    @inherit_env : Bool
    @cwd         : Path?
    @stdin       : Iterator[i8]?
    @stdout      : Writer[i8]?
    @stderr      : Writer[i8]?

    getters @program, @args, @cwd

    def init(@program : String) {
        @args = [] of String;
        @env = []; @inherit_env = true; @cwd = nil;
        @stdin = nil; @stdout = nil; @stderr = nil;
    }
    def init(@program : String, @args : Collection[String]) {
        @env = []; @inherit_env = true; @cwd = nil;
        @stdin = nil; @stdout = nil; @stderr = nil;
    }

    // ---- configuration ----

    def cwd(path : Path)   -> Self { @cwd = path; return self; }
    def cwd(path : String) -> Self { @cwd = Path.new(path); return self; }

    def env(key : String, val : String) -> Self {
        @env.push(Pair{key, val});
        return self;
    }
    def clean_env() -> Self { @inherit_env = false; @env.clear(); return self; }

    def stdin(src : Iterator[i8]) -> Self  { @stdin = src; return self; }
    def stdin(src : Iterable[i8]) -> Self  { @stdin = src.iterator(); return self; }
    def stdin(src : String)       -> Self  { @stdin = src.bytes().iterator(); return self; }
    def stdout(sink : Writer[i8]) -> Self  { @stdout = sink; return self; }
    def stderr(sink : Writer[i8]) -> Self  { @stderr = sink; return self; }

    // ---- execution ----

    def run() -> Output {
        stdin_buf = Buffer[i8].new(0);
        stdin_len = 0 as i64;
        src = @stdin;

        if src is Iterator[i8] {
            list = [] of i8;
            list.write_from(src);
            stdin_len =  list.size();
            stdin_buf = Buffer[i8].new(stdin_len);
            for (i, elem) in list.enumerate() { buf.[i] = elem; }
        }

        program_c = @program.c_string();
        (argv, argc) = pack_argv(@args);
        (envp, envc) = pack_envp(@env);
        cwd_c = pack_cwd(@cwd);

        out_buf  = Buffer[Buffer[i8]].new(1);
        out_len  = Buffer[i64].new(1);
        err_buf  = Buffer[Buffer[i8]].new(1);
        err_len  = Buffer[i64].new(1);
        code     = Buffer[i32].new(1);
        killed   = Buffer[i32].new(1);

        rc = process_run_capture(
            program_c, argv, argc, envp, envc,
            if @inherit_env { 1 } else { 0 },
            cwd_c,
            stdin_buf, stdin_len,
            1, 1,
            out_buf, out_len, err_buf, err_len,
            code, killed
        );
        if rc != 0 { yield(SubprocessError{"run failed"}); }

        out = String.from_bytes_lossy(Slice{out_buf.[0], out_len.[0] as i32, 0});
        err = String.from_bytes_lossy(Slice{err_buf.[0], err_len.[0] as i32, 0});

        sout = @stdout;
        if sout is Writer[i8] { sout.write_from(out.bytes()); }
        serr = @stderr;
        if serr is Writer[i8] { serr.write_from(err.bytes()); }

        return Output{out, err, ExitStatus{code.[0], killed.[0] == 1}};
    }

    def exec() -> ExitStatus {
        if @stdout is not Nil { yield(SubprocessError{
            "stdout sink is incompatible with exec(); use run()"
        }); }
        if @stderr is not Nil { yield(SubprocessError{
            "stderr sink is incompatible with exec(); use run()"
        }); }

        program_c = @program.c_string();
        (argv, argc) = pack_argv(@args);
        (envp, envc) = pack_envp(@env);
        cwd_c = pack_cwd(@cwd);

        handle = Buffer[i64].new(1);
        chans  = Buffer[i32].new(3);

        src = @stdin;
        stdin_mode = 0;
        if src is Iterator[i8] { stdin_mode = 2; }

        rc = process_spawn(
            program_c, argv, argc, envp, envc,
            if @inherit_env { 1 } else { 0 },
            cwd_c,
            stdin_mode, 0, 0,
            handle, chans
        );
        if rc != 0 { yield(SubprocessError{"spawn failed"}); }

        if src is Iterator[i8] {
            pipe = PipeIn{chans.[0]};
            pipe.write_from(src);
            pipe.close();
        }

        return Process{handle.[0], nil, nil, nil}.wait();
    }

    def start() -> Process {
        if @stdout is Writer[i8] { yield(SubprocessError{
            "stdout sink is incompatible with start(); read proc.stdout() yourself"
        }); }
        if @stderr is Writer[i8] { yield(SubprocessError{
            "stderr sink is incompatible with start(); read proc.stderr() yourself"
        }); }

        program_c = @program.c_string();
        (argv, argc) = pack_argv(@args);
        (envp, envc) = pack_envp(@env);
        cwd_c = pack_cwd(@cwd);

        handle = Buffer[i64].new(1);
        chans  = Buffer[i32].new(3);

        rc = process_spawn(
            program_c, argv, argc, envp, envc,
            if @inherit_env { 1 } else { 0 },
            cwd_c,
            2, 2, 2,
            handle, chans
        );
        if rc != 0 { yield(SubprocessError{"spawn failed"}); }

        stdin_pipe : PipeIn?;
        src = @stdin;
        if src is Iterator[i8] {
            pipe = PipeIn{chans.[0]};
            pipe.write_from(src);
            pipe.close();
            stdin_pipe = nil;
        } else {
            stdin_pipe = PipeIn{chans.[0]};
        }

        return Process{handle.[0], stdin_pipe, PipeOut{chans.[1]}, PipeOut{chans.[2]}};
    }
}

def pack_argv(args : Collection[String]) -> Pair[Buffer[Buffer[i8]], i32] {
    n = args.size();
    buf = Buffer[Buffer[i8]].new(n);
    for (i, a) in args.enumerate() { buf.[i] = a.c_string(); }
    return Pair{buf, n};
}

def pack_envp(env : Collection[Pair[String, String]]) -> Pair[Buffer[Buffer[i8]], i32] {
    n = env.size();
    buf = Buffer[Buffer[i8]].new(n);
    for (i, (k, v)) in env.enumerate() { buf.[i] = "${k}=${v}".c_string(); }
    return Pair{buf, n};
}

def pack_cwd(p : Path?) -> Buffer[i8] {
    if p is Path { return p.to_string().c_string(); }
    return "".c_string();
}

// fire and check
out = Command{"git", ["status", "--porcelain"]}.run();
if out.ok() { print(out.stdout()); }

// configured
out = Command{"git", ["log", "-n", "1"]}
    .cwd("/srv/repo")
    .env("GIT_PAGER", "cat")
    .run();

// editor: inherit stdio, return only the status
status = Command{"vim", [filename]}.exec();

// stream
p = Command{"gzip"}.start();
p.stdin().write_from(input_bytes);
p.stdin().close();
for b in p.stdout() { sink.write(b); }
status = p.wait();

// piped sort, no buffering by hand
Command{"sort"}.stdin(unsorted_lines).stdout(out_writer).run();

// fan out
cmd = Command{"curl", ["-sS", url]};
procs = [] of Process;
for i in 0..4 { procs.push(cmd.start()); }
for proc in procs { proc.wait(); }