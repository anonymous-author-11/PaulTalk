import collection;
import iteration;
import writer;

class List[T] extends Collection[T] {

    // must be able to create an empty List with no arguments
    abstract def Self.empty() -> Self ~> no_alias

    // Create a List from any iterable, even of unknown size
    // 'my_iterable into List' can desugar to this method
    abstract def Self.from_iterable(iterable : Iterable[T]) -> Self

    // append always increases .size() by 1
    abstract def append(x : T) -> Self {
    } ~> { $elems holds x, ret == self }

    // iterator.next() should be O(1) wrt size of list
    abstract def iterator() -> Iterator[T]

    // we do not provide List.set(index, value)
    // mutating the middle of the list maybe be impossible for some subtypes

    def length() -> i32 { return self.size(); } ~> no_alias

    // O(1) time complexity
    def first() -> T? {
    	if self.is_empty() { return nil; }
    	for elem in self { return elem; }
    }

    // O(size) time complexity
    def last() -> T? {
    	return self.at(self.size() - 1);
    }

    // .at(index) has O(index) time complexity
    // .index_of has O(index) time complexity

    // No time complexity guarantees
    def extend(other : Iterator[T]) -> Self {
        nxt = other.next();
        while nxt is T {
            self.append(nxt);
            nxt = other.next();
        }
        return self;
    } ~> { $elems holds other$nxt, ret == self }

    // No time complexity guarantees
    def extend(other : Iterable[T]) -> Self {
        for x in other { self.append(x); }
        return self;
    } ~> { $elems holds other$elems, ret == self }

    def writer() -> Writer[T] {
        return ListWriter{self};
    } ~> { ret holds self, ret$dest == $elems }

}

class ListWriter[T] extends Writer[T] {
    @list : List[T]

    regions { $dest == @list$elems }

    def init(@list : List[T]) {
    }
    def write(value : T) {
        @list.append(value);
    }
}
