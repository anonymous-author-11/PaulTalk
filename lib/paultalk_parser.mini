class ParseResult {
    @tree : ParseNode
    @errors : Array[ParseError]

    getters @tree, @errors

    def init(@tree : ParseNode, @errors : Array[ParseError]) {
    }

    def has_errors() -> Bool { return @errors.size() > 0; }

    def formatted_errors(source : String) -> String {
        return format_parse_errors(source, @errors);
    }

    def print_errors(source : String) {
        text = self.formatted_errors(source);
        if text.byte_length() == 0 { return; }
        print(text);
    }
}

def line_text_at(source : String, line_number : i32) -> String {
    if line_number < 1 { return ""; }
    line_text = source.lines().at(line_number - 1);
    if line_text is Nil { return ""; }
    return trim_trailing_cr(line_text.bytes()).to_string();
}

def trim_trailing_cr(text : StringBytes) -> StringBytes {
    if not text.ends_with("\r") { return text; }
    return text.slice(0, text.size() - 1);
}

def format_parse_error(source : String, error : ParseError) -> String {
    line_number = error.line();
    column = error.column();
    if column < 1 { column = 1; }

    line_number_text = line_number as String;
    source_line = line_text_at(source, line_number);
    pointer = " ".repeat(column - 1).extend("^");
    gutter_pad = " ".repeat(line_number_text.byte_length());
    return error.header()
        .extend("\n${line_number} | ${source_line}")
        .extend("\n${gutter_pad} | ${pointer}");
}

def format_parse_errors(source : String, errors : Array[ParseError]) -> String {
    if errors.size() == 0 { return ""; }
    rendered = [] of String;
    for error in errors { rendered.append(format_parse_error(source, error)); }
    return "\n\n".join(rendered);
}

class PaulTalkLexer {
    @source : String
    @tokens : Array[Token]
    @errors : Array[ParseError]
    @length : i32
    @cursor : i32
    @line : i32
    @column : i32
    @last_error_cursor : i32

    getters @errors

    def init(@source : String) {
        @tokens = [] of Token;
        @errors = [] of ParseError;
        @length = @source.byte_length();
        @cursor = 0;
        @line = 1;
        @column = 1;
        @last_error_cursor = -1;
    }

    def tokenize() -> Array[Token] {
        while not self.at_end() {
            self.skip_ignored();
            if self.at_end() { break; }

            start = @cursor;
            line = @line;
            column = @column;
            byte = self.peek_byte();
            handled = self.scan_token(byte, line, column, start);
            if handled { continue; }
            self.scan_symbol(line, column, start);
        }
        return @tokens.append(EOF{"<eof>", @line, @column});
    }

    def scan_token(byte : i8, line : i32, column : i32, start : i32) -> Bool {
        if byte == ('@' as i8) {
            self.scan_field(line, column, start);
            return true;
        }
        if byte == ('$' as i8) {
            self.scan_region(line, column, start);
            return true;
        }
        if ASCII.is_alpha(byte) {
            self.scan_identifier(line, column, start);
            return true;
        }
        if ASCII.is_digit(byte) {
            self.scan_number(line, column, start);
            return true;
        }
        if byte == ('"' as i8) {
            self.scan_string_literal(line, column, start);
            return true;
        }
        if byte == ('\'' as i8) {
            self.scan_char_literal(line, column, start);
            return true;
        }
        return false;
    }

    def at_end() -> Bool { return @cursor >= @length; }

    def peek_byte() -> i8 {
        if self.at_end() { return 0 as i8; }
        return @source.unchecked_index(@cursor);
    }

    def peek_byte_at(offset : i32) -> i8 {
        index = @cursor + offset;
        if index < 0 or index >= @length { return 0 as i8; }
        return @source.unchecked_index(index);
    }

    def advance_byte() -> i8 {
        byte = self.peek_byte();
        @cursor = @cursor + 1;
        if byte == ('\n' as i8) {
            @line = @line + 1;
            @column = 1;
            return byte;
        }
        @column = @column + 1;
        return byte;
    }

    def slice_from(start : i32) -> String {
        return @source.bytes().slice(start, @cursor).to_string();
    }

    def skip_ignored() {
        while not self.at_end() {
            byte = self.peek_byte();
            is_ws = ASCII.is_whitespace(byte);
            if is_ws { self.advance_byte(); }
            if is_ws { continue; }
            if byte != ('/' as i8) { return; }
            if not self.skip_comment_after_slash() { return; }
        }
    }

    def skip_comment_after_slash() -> Bool {
        if self.peek_byte_at(1) == ('/' as i8) {
            self.advance_byte();
            self.advance_byte();
            self.skip_line_comment();
            return true;
        }
        if self.peek_byte_at(1) != ('*' as i8) { return false; }
        self.advance_byte();
        self.advance_byte();
        self.skip_block_comment();
        return true;
    }

    def skip_line_comment() {
        while not self.at_end() {
            if self.peek_byte() == ('\n' as i8) { return; }
            self.advance_byte();
        }
    }

    def skip_block_comment() {
        while not self.at_end() {
            byte = self.advance_byte();
            if byte != ('*' as i8) { continue; }
            if self.peek_byte() != ('/' as i8) { continue; }
            self.advance_byte();
            return;
        }
        self.record_error("Unterminated block comment.", @line, @column);
    }

    def scan_field(line : i32, column : i32, start : i32) {
        self.advance_byte();
        if not self.is_identifier_start_byte(self.peek_byte()) {
            self.record_error("Expected identifier after '@'.", line, column);
        }
        while self.is_identifier_continue_byte(self.peek_byte()) {
            self.advance_byte();
        }
        text = self.slice_from(start);
        @tokens.append(Field{text, line, column});
    }

    def scan_region(line : i32, column : i32, start : i32) {
        self.advance_byte();
        if not self.is_identifier_start_byte(self.peek_byte()) {
            self.record_error("Expected identifier after '\$'.", line, column);
        }
        while self.is_identifier_continue_byte(self.peek_byte()) {
            self.advance_byte();
        }
        text = self.slice_from(start);
        @tokens.append(RegionName{text, line, column});
    }

    def scan_identifier(line : i32, column : i32, start : i32) {
        self.advance_byte();
        while self.is_identifier_continue_byte(self.peek_byte()) {
            self.advance_byte();
        }
        text = self.slice_from(start);
        if self.is_keyword(text) {
            @tokens.append(Keyword{text, line, column});
            return;
        }
        first = @source.unchecked_index(start) as i32;
        if first >= 65 and first <= 90 {
            @tokens.append(TypeIdentifier{text, line, column});
            return;
        }
        @tokens.append(Identifier{text, line, column});
    }

    def scan_number(line : i32, column : i32, start : i32) {
        if self.starts_hex_literal() {
            self.advance_byte();
            self.advance_byte();
            bad_hex = not ASCII.is_hex(self.peek_byte());
            bad_message = "Expected hex digits.";
            if bad_hex { self.record_error(bad_message, line, column); }
            self.consume_hex_digits();
            @tokens.append(HexLiteral{self.slice_from(start), line, column});
            return;
        }
        self.consume_digits();
        if not self.starts_float_fraction() {
            @tokens.append(IntLiteral{self.slice_from(start), line, column});
            return;
        }
        self.advance_byte();
        self.consume_digits();
        @tokens.append(FloatLiteral{self.slice_from(start), line, column});
    }

    def consume_hex_digits() {
        while self.is_hex_digit_or_underscore(self.peek_byte()) {
            self.advance_byte();
        }
    }

    def consume_digits() {
        while self.is_digit_or_underscore(self.peek_byte()) {
            self.advance_byte();
        }
    }

    def starts_hex_literal() -> Bool {
        if self.peek_byte() != ('0' as i8) { return false; }
        return self.peek_byte_at(1) == ('x' as i8) or
            self.peek_byte_at(1) == ('X' as i8);
    }

    def starts_float_fraction() -> Bool {
        if self.peek_byte() != ('.' as i8) { return false; }
        if self.peek_byte_at(1) == ('.' as i8) { return false; }
        return ASCII.is_digit(self.peek_byte_at(1));
    }

    def scan_string_literal(line : i32, col : i32, start : i32) {
        self.advance_byte();
        while not self.at_end() {
            byte = self.peek_byte();
            is_quote = byte == ('"' as i8);
            is_escape = byte == ('\\' as i8);
            if byte == ('"' as i8) { self.advance_byte(); }
            if is_quote { self.emit_string(line, col, start); }
            if is_quote { return; }
            if is_escape { self.advance_byte(); }
            if is_escape and self.at_end() { break; }
            if is_escape { self.advance_byte(); }
            if is_escape { continue; }
            self.advance_byte();
        }
        self.record_error("Unterminated string literal.", line, col);
    }

    def emit_string(line : i32, col : i32, start : i32) {
        str = StringLiteral{self.slice_from(start), line, col};
        @tokens.append(str);
    }

    def scan_char_literal(line : i32, col : i32, start : i32) {
        bad_message = "Char literal must have one char.";
        line_message = "Character literal cannot span lines.";
        self.advance_byte();
        char_count = 0;
        while not self.at_end() {
            byte = self.peek_byte();
            is_quote = byte == ('\'' as i8);
            is_escape = byte == ('\\' as i8);
            bad_count = is_quote and char_count != 1;
            if bad_count { self.record_error(bad_message, line, col); }
            if is_quote { self.advance_byte(); }
            if is_quote { self.emit_char(line, col, start); }
            if is_quote { return; }
            if is_escape { self.advance_byte(); }
            if is_escape and self.at_end() { break; }
            if is_escape { self.advance_byte(); }
            if is_escape { char_count = char_count + 1; }
            if is_escape { continue; }
            is_newline = byte == ('\n' as i8);
            if is_newline { self.record_error(line_message, line, col); }
            self.advance_byte();
            char_count = char_count + 1;
        }
        self.record_error("Unterminated char literal.", line, col);
    }

    def emit_char(line : i32, col : i32, start : i32) {
        str = CharLiteral{self.slice_from(start), line, col};
        @tokens.append(str);
    }

    def scan_symbol(line : i32, col : i32, start : i32) {
        first_byte = self.peek_byte();
        second_byte = self.peek_byte_at(1);
        third_byte = self.peek_byte_at(2);
        is_three = first_byte == ('[' as i8) and second_byte == (']' as i8);
        if is_three { is_three = third_byte == ('=' as i8); }
        if not is_three {
            is_three = first_byte == ('.' as i8) and second_byte == ('.' as i8);
            if is_three { is_three = third_byte == ('.' as i8); }
        }
        if is_three { self.emit_symbol(3, line, col, start); }
        if is_three { return; }
        if self.is_two_char_symbol(first_byte, second_byte) {
            self.emit_symbol(2, line, col, start);
            return;
        }
        if self.is_single_char_symbol(first_byte) {
            self.emit_symbol(1, line, col, start);
            return;
        }

        self.advance_byte();
        message = "Unexpected character: ${self.slice_from(start)}";
        self.record_error(message, line, col);
    }

    def emit_symbol(bytes : i32, line : i32, col : i32, start : i32) {
        while bytes > 0 {
            self.advance_byte();
            bytes = bytes - 1;
        }
        @tokens.append(Symbol{self.slice_from(start), line, col});
    }

    def is_two_char_symbol(left : i8, right : i8) -> Bool {
        (l_char, r_char) = (Character{left as i32}, Character{right as i32});
        if l_char == '=' { return r_char == '>' or r_char == '='; }
        if l_char == '<' {
            return r_char == '=' or r_char == ':'  or r_char == '<';
        }
        if l_char == '>' { return r_char == '=' or r_char == '>'; }
        if l_char == '-' { return r_char == '>'; }
        if l_char == '!' { return r_char == '='; }
        if l_char == '[' { return r_char == ']'; }
        if l_char == '.' { return r_char == '.'; }
        if l_char == '~' { return r_char == '>'; }
        return false;
    }

    def is_single_char_symbol(byte : i8) -> Bool {
        char = Character{byte as i32};
        if char == '%' or char == '[' or char == ']' { return true; }
        if byte >= ('(' as i8) and byte <= ('/' as i8) { return true; }
        if byte >= (':' as i8) and byte <= ('?' as i8) { return true; }
        return byte >= ('{' as i8) and byte <= ('}' as i8);
    }

    def is_keyword(text : String) -> Bool {
        keywords = [
            "if", "in", "is", "or", "of", "as", "def", "for", "not", "nil",
            "and", "else", "true", "from", "into", "class", "alias", "while",
            "break", "yield", "holds", "import", "export", "extern",
            "setter", "return", "getter", "yields", "sizeof", "bit_or",
            "bit_xor", "where", "regions", "extends", "abstract",
            "getters", "setters", "continue", "no_alias", "all_alias",
            "no_export", "bit_and"
        ];
        for keyword in keywords { if keyword == text { return true; } }
        return false;
    }

    def is_identifier_start_byte(byte : i8) -> Bool {
        return ASCII.is_alpha(byte) or byte == ('_' as i8);
    }

    def is_identifier_continue_byte(byte : i8) -> Bool {
        return self.is_identifier_start_byte(byte) or ASCII.is_digit(byte);
    }

    def is_digit_or_underscore(byte : i8) -> Bool {
        return ASCII.is_digit(byte) or byte == ('_' as i8);
    }

    def is_hex_digit_or_underscore(byte : i8) -> Bool {
        return ASCII.is_hex(byte) or byte == ('_' as i8);
    }

    def record_error(message : String, line : i32, column : i32) {
        if @cursor == @last_error_cursor { return; }
        @last_error_cursor = @cursor;
        @errors.append(ParseError{message, line, column});
    }

}

class PaulTalkParser {
    @tokens : Array[Token]
    @cursor : i32
    @errors : Array[ParseError]
    @last_error_cursor : i32

    getters @errors

    def init(@tokens : Array[Token]) {
        @cursor = 0;
        @errors = [] of ParseError;
        @last_error_cursor = -1;
    }

    def parse_program() -> ParseNode {
        root = Program{};
        while not self.is_at_end() {
            root.add(self.parse_statement_with_recovery());
        }
        return root;
    }

    def parse_statement() -> ParseNode {
        if self.match_lexeme("import") { return self.parse_import_statement(); }
        if self.match_lexeme("export") { return self.parse_export_statement(); }
        if self.match_lexeme("no_export") { return self.parse_no_export_statement(); }
        if self.match_lexeme("alias") { return self.parse_alias_statement(); }
        if self.match_lexeme("extern") { return self.parse_extern_statement(); }
        if self.match_lexeme("def") { return self.parse_function_definition(); }
        if self.match_lexeme("class") { return self.parse_class_definition(); }
        if self.match_lexeme("if") { return self.parse_if_statement(); }
        if self.match_lexeme("while") { return self.parse_while_statement(); }
        if self.match_lexeme("for") { return self.parse_for_statement(); }
        if self.match_lexeme("return") { return self.parse_return_statement(); }
        if self.match_lexeme("break") { return self.parse_break_statement(); }
        if self.match_lexeme("continue") { return self.parse_continue_statement(); }
        if self.match_lexeme("{") {
            return self.parse_block_after_open(self.previous());
        }
        return self.parse_binding_assignment_or_expression_statement();
    }

    def parse_statement_with_recovery() -> ParseNode {
        start = @cursor;
        first = self.peek();
        error_count = @errors.size();
        node = self.parse_statement();
        if @errors.size() == error_count {
            self.ensure_progress(start);
            return node;
        }
        self.synchronize_statement();
        self.ensure_progress(start);
        error_node = ErrorStmt{first.line(), first.column()};
        return error_node.add(node);
    }

    def parse_import_statement() -> ParseNode {
        start = self.previous();
        node = ImportStmt{start.line(), start.column()};
        first = "Expected module name.";
        node.add(self.parse_qualified_name(first));
        self.expect_lexeme(";", "Expected ';' after import statement.");
        return node;
    }

    def parse_export_statement() -> ParseNode {
        start = self.previous();
        node = ExportStmt{start.line(), start.column()};
        return self.finish_name_list(
            node,
            "Expected exported name.",
            "Expected ';' after export statement."
        );
    }

    def parse_no_export_statement() -> ParseNode {
        start = self.previous();
        node = NoExportStmt{start.line(), start.column()};
        return self.finish_name_list(
            node,
            "Expected hidden name.",
            "Expected ';' after no_export statement."
        );
    }

    def finish_name_list(node : ParseNode, first_msg : String, end_msg : String) -> ParseNode {
        node.add(self.parse_qualified_name(first_msg));
        while self.match_lexeme(",") { node.add(self.parse_qualified_name(first_msg)); }
        self.expect_lexeme(";", end_msg);
        return node;
    }

    def parse_qualified_name(first_msg : String) -> ParseNode {
        first = self.expect_identifier(first_msg);
        node = QualifiedName{first.line(), first.column()};
        node.add(PathSegment{first.lexeme(), first.line(), first.column()});
        while self.match_lexeme(".") {
            segment = self.expect_identifier("Expected identifier after '.'.");
            node.add(PathSegment{segment.lexeme(), segment.line(), segment.column()});
        }
        return node;
    }

    def parse_alias_statement() -> ParseNode {
        start = self.previous();
        name = self.expect_identifier("Expected alias name after 'alias'.");
        self.expect_lexeme("=", "Expected '=' in alias declaration.");
        type_node = self.parse_type();
        self.expect_lexeme(";", "Expected ';' after alias declaration.");

        return AliasStmt{name.lexeme(), start.line(), start.column()}
            .add(type_node);
    }

    def parse_extern_statement() -> ParseNode {
        start = self.previous();
        self.expect_lexeme("def", "Expected 'def' after 'extern'.");
        name = self.expect_identifier(
            "Expected function name in extern declaration."
        );
        node = ExternDef{name.lexeme(), start.line(), start.column()};
        self.parse_parameters(node, false);
        self.parse_optional_constraints(node);
        return node;
    }

    def parse_function_definition() -> ParseNode {
        start = self.previous();
        name = self.expect_identifier("Expected function name after 'def'.");
        node = FunctionDef{name.lexeme(), start.line(), start.column()};
        self.parse_parameters(node, false);
        node.add(self.parse_block());
        self.parse_optional_constraints(node);
        return node;
    }

    def parse_class_definition() -> ParseNode {
        start = self.previous();
        node = ClassDef{start.line(), start.column()};
        node.add(self.parse_type_primary());

        if self.match_lexeme("extends") {
            extends_node = Extends{};
            extends_node.add(self.parse_type());
            ext = extends_node;
            while self.match_lexeme(",") { ext.add(self.parse_type()); }
            node.add(extends_node);
        }

        if self.match_lexeme("where") {
            where_node = Where{};
            where_node.add(self.parse_where_item());
            w = where_node;
            while self.match_lexeme(",") { w.add(self.parse_where_item()); }
            node.add(where_node);
        }

        self.expect_lexeme("{", "Expected '{' to begin class body.");
        body = ClassBody{};

        while not self.check_lexeme("}") and not self.is_at_end() {
            body.add(self.parse_class_member_with_recovery());
        }

        self.expect_lexeme("}", "Expected '}' after class body.");
        node.add(body);
        return node;
    }

    def parse_class_member_with_recovery() -> ParseNode {
        start = @cursor;
        first = self.peek();
        error_count = @errors.size();
        node = self.parse_class_member();
        if @errors.size() == error_count {
            self.ensure_progress(start);
            return node;
        }
        self.synchronize_class_member();
        self.ensure_progress(start);
        error_node = ErrorMember{first.line(), first.column()};
        return error_node.add(node);
    }

    def parse_where_item() -> ParseNode {
        token = self.expect_identifier("Expected type variable.");
        bound = WhereBound{token.line(), token.column()};
        bound.add(Name{token.lexeme(), token.line(), token.column()});
        self.expect_lexeme("<:", "Expected '<:' in where clause.");
        return bound.add(self.parse_type());
    }

    def parse_class_member() -> ParseNode {
        if self.match_lexeme("regions") {
            start = self.previous();
            node = RegionsClause{start.line(), start.column()};
            message = "Expected regions constraints.";
            return node.add(self.parse_constraint_list(message));
        }
        if self.match_any(["getter", "setter", "getters", "setters"]) {
            return self.parse_accessor_directive(self.previous());
        }
        if self.peek() is Field {
            field = self.expect_field("Expected field declaration.");
            self.expect_lexeme(":", "Expected ':' after field name.");
            field_node = FieldDecl{field.lexeme(), field.line(), field.column()};
            return field_node.add(self.parse_type());
        }
        if self.peek() is RegionName {
            region = self.expect_region_name("Expected region declaration.");
            self.expect_lexeme(":", "Expected ':' after region name.");
            region_node = RegionDecl{region.lexeme(), region.line(), region.column()};
            return region_node.add(self.parse_type());
        }
        if self.match_any(["abstract", "def"]) {
            return self.parse_method_definition(self.previous());
        }
        token = self.advance();
        message = "Unexpected token in class body: ${token.lexeme()}";
        self.fail(message);
        return UnknownMemberToken{
            token.lexeme(),
            token.line(),
            token.column()
        };
    }

    def parse_accessor_directive(start : Token) -> ParseNode {
        node = AccessorDirective{
            start.lexeme(),
            start.line(),
            start.column()
        };
        field = self.expect_field("Expected field name in accessor directive.");
        node.add(FieldName{field.lexeme(), field.line(), field.column()});
        while self.match_lexeme(",") {
            next_field = self.expect_field("Expected field name after ','.");
            node.add(FieldName{next_field.lexeme(), next_field.line(), next_field.column()});
        }
        return node;
    }

    def parse_method_definition(start : Token) -> ParseNode {
        is_abstract = start.lexeme() == "abstract";
        if is_abstract {
            self.expect_lexeme("def", "Expected 'def' after 'abstract'.");
        }

        first_name = self.expect_method_name();
        receiver = nil;
        name = first_name;
        if first_name.lexeme() == "Self" and self.match_lexeme(".") {
            receiver = first_name;
            name = self.expect_method_name();
        }

        node = MethodDef{name.lexeme(), start.line(), start.column()};
        if is_abstract { self.add_abstract_modifier(node, name); }
        if receiver is Token {
            node.add(ClassReceiver{receiver.lexeme(), receiver.line(), receiver.column()});
        }
        if name is Identifier and self.match_lexeme("=") {
            suffix = self.previous();
            node.add(SetterSuffix{suffix.lexeme(), suffix.line(), suffix.column()});
        }

        self.parse_optional_generic_parameters(node);
        self.parse_parameters(node, true);
        self.add_method_block(node, is_abstract, name);
        self.parse_optional_constraints(node);
        return node;
    }

    def add_method_block(node : ParseNode, is_abstract : Bool, name : Token) {
        if self.match_lexeme("{") {
            node.add(self.parse_block_after_open(self.previous()));
            return;
        }
        if is_abstract {
            node.add(Block{name.line(), name.column()});
            return;
        }
        self.fail("Expected '{' to begin method body.");
    }

    def add_abstract_modifier(node : ParseNode, name : Token) {
        abstract_token = Identifier{"abstract", name.line(), name.column()};
        node.add(Modifier{
            abstract_token.lexeme(),
            abstract_token.line(),
            abstract_token.column()
        });
    }

    def parse_if_statement() -> ParseNode {
        start = self.previous();
        node = IfStmt{start.line(), start.column()};
        node.add(self.parse_expression());
        node.add(self.parse_block());
        if self.match_lexeme("else") { node.add(self.parse_block()); }
        return node;
    }

    def parse_while_statement() -> ParseNode {
        start = self.previous();
        node = WhileStmt{start.line(), start.column()};
        node.add(self.parse_expression());
        return node.add(self.parse_block());
    }

    def parse_for_statement() -> ParseNode {
        start = self.previous();
        node = ForStmt{start.line(), start.column()};
        if self.match_lexeme("(") {
            open = self.previous();
            target = TupleTarget{open.line(), open.column()};
            msg = "Expected tuple target identifier.";
            first = self.expect_identifier(msg);
            target.add(Name{first.lexeme(), first.line(), first.column()});
            self.expect_lexeme(",", "Expected ',' in tuple loop target.");
            second = self.expect_identifier(msg);
            target.add(Name{second.lexeme(), second.line(), second.column()});
            while self.match_lexeme(",") { self.add_id(target, msg); }
            self.expect_lexeme(")", "Expected ')' after tuple loop target.");
            node.add(target);
        } else {
            name = self.expect_identifier("Expected loop target identifier.");
            node.add(Name{name.lexeme(), name.line(), name.column()});
        }

        self.expect_lexeme("in", "Expected 'in' after loop target.");
        node.add(self.parse_expression());
        node.add(self.parse_block());
        return node;
    }

    def parse_return_statement() -> ParseNode {
        start = self.previous();
        node = ReturnStmt{start.line(), start.column()};
        if self.match_lexeme(";") { return node; }
        node.add(self.parse_expression());
        self.expect_lexeme(";", "Expected ';' after return statement.");
        return node;
    }

    def parse_break_statement() -> ParseNode {
        token = self.previous();
        self.expect_lexeme(";", "Expected ';' after 'break'.");
        return BreakStmt{token.line(), token.column()};
    }

    def parse_continue_statement() -> ParseNode {
        token = self.previous();
        self.expect_lexeme(";", "Expected ';' after 'continue'.");
        return ContinueStmt{token.line(), token.column()};
    }

    def add_id(node : ParseNode, message : String) {
        token = self.expect_identifier(message);
        node.add(Name{token.lexeme(), token.line(), token.column()});
    }

    def parse_binding_assignment_or_expression_statement() -> ParseNode {
        lhs = self.parse_expression();
        if self.match_lexeme(":") {
            message = "Variable declaration target must be an identifier.";
            if lhs is not Name { self.fail(message); }
            node = VarDecl{lhs.line(), lhs.column()}.add(lhs);
            node.add(self.parse_type());
            if self.match_lexeme("=") { node.add(self.parse_expression()); }
            self.expect_lexeme(";", "Expected ';' after variable declaration.");
            return node;
        }
        if self.match_lexeme("=") {
            message = "Left-hand side of assignment is not assignable.";
            if not lhs.is_assignable() { self.fail(message); }
            node = Assignment{"=", lhs.line(), lhs.column()};
            node.add(lhs);
            node.add(self.parse_expression());
            self.expect_lexeme(";", "Expected ';' after assignment.");
            return node;
        }
        self.expect_lexeme(";", "Expected ';' after expression statement.");
        node = ExprStmt{lhs.line(), lhs.column()};
        node.add(lhs);
        return node;
    }

    def parse_block() -> ParseNode {
        open = self.expect_lexeme("{", "Expected '{' to begin block.");
        return self.parse_block_after_open(open);
    }

    def parse_block_after_open(open : Token) -> ParseNode {
        node = Block{open.line(), open.column()};
        while not self.check_lexeme("}") and not self.is_at_end() {
            node.add(self.parse_statement_with_recovery());
        }
        self.expect_lexeme("}", "Expected '}' after block.");
        return node;
    }

    def parse_expression() -> ParseNode { return self.parse_logical_or(); }

    def parse_logical_or() -> ParseNode {
        left = self.parse_logical_and();
        while self.match_lexeme("or") {
            op = self.previous();
            right = self.parse_logical_and();
            left = LogicalOr{op.lexeme(), op.line(), op.column()}.add(left).add(right);
        }
        return left;
    }

    def parse_logical_and() -> ParseNode {
        left = self.parse_comparison();
        while self.match_lexeme("and") {
            op = self.previous();
            right = self.parse_comparison();
            left = LogicalAnd{op.lexeme(), op.line(), op.column()}.add(left).add(right);
        }
        return left;
    }

    def parse_comparison() -> ParseNode {
        left = self.parse_additive();
        while true {
            next = self.parse_comparison_step(left);
            if next is not ParseNode { return left; }
            left = next;
        }
    }

    def parse_comparison_step(left : ParseNode) -> ParseNode? {
        if self.match_any(["==", "!="]) {
            op = self.previous();
            right = self.parse_additive();
            return Equality{op.lexeme(), op.line(), op.column()}.add(left).add(right);
        }
        if self.match_any(["<", ">", "<=", ">=", "..", "..."]) {
            op = self.previous();
            right = self.parse_additive();
            return Comparison{op.lexeme(), op.line(), op.column()}.add(left).add(right);
        }
        if not self.match_lexeme("is") { return nil; }
        op = self.previous();
        is_not = self.match_lexeme("not");
        right = self.parse_type();
        if is_not { return IsNotCheck{op.lexeme(), op.line(), op.column()}.add(left).add(right); }
        return IsCheck{op.lexeme(), op.line(), op.column()}.add(left).add(right);
    }

    def parse_additive() -> ParseNode {
        left = self.parse_multiplicative();
        while self.match_any(["+", "-"]) {
            op = self.previous();
            right = self.parse_multiplicative();
            left = Additive{op.lexeme(), op.line(), op.column()}.add(left).add(right);
        }
        return left;
    }

    def parse_multiplicative() -> ParseNode {
        left = self.parse_vector();
        ops = ["*", "/", "%", "<<", ">>", "bit_and", "bit_or", "bit_xor"];
        while self.match_any(ops) {
            op = self.previous();
            right = self.parse_vector();
            left = Multiplicative{op.lexeme(), op.line(), op.column()}.add(left).add(right);
        }
        return left;
    }

    def parse_vector() -> ParseNode {
        left = self.parse_cast();
        if not self.match_lexeme("of") and not self.match_lexeme("from") {
            return left;
        }
        op = self.previous();
        right = self.parse_vector();
        return VectorOp{op.lexeme(), op.line(), op.column()}.add(left).add(right);
    }

    def parse_cast() -> ParseNode {
        left = self.parse_unary();
        while self.match_lexeme("as") or self.match_lexeme("into") {
            op = self.previous();
            right = self.parse_type();
            left = Cast{op.lexeme(), op.line(), op.column()}.add(left).add(right);
        }
        return left;
    }

    def parse_unary() -> ParseNode {
        if self.match_lexeme("-") or self.match_lexeme("not") {
            op = self.previous();
            expr = self.parse_unary();
            node = Unary{op.lexeme(), op.line(), op.column()};
            node.add(expr);
            return node;
        }
        return self.parse_postfix();
    }

    def parse_postfix() -> ParseNode {
        node = self.parse_primary();
        while true {
            start = @cursor;
            node = self.parse_postfix_suffix(node);
            if @cursor == start { return node; }
        }
    }

    def parse_postfix_suffix(node : ParseNode) -> ParseNode {
        if self.match_lexeme("[") and node.can_parameterize() {
            named = ParameterizedName{node.line(), node.column()};
            named.add(node);
            named.add(self.parse_type_list("]"));
            return named;
        }
        if self.match_lexeme("(") {
            return CallExpr{node.line(), node.column()}
            .add(node)
            .add(self.parse_expression_list(")"));
        }
        if not self.match_lexeme(".") {
            if not self.check_lexeme("{") { return node; }
            if not node.is_object_creation_target() { return node; }
            open = self.expect_lexeme("{", "Expected '{' in object creation.");
            object = ObjectCreation{open.line(), open.column()};
            object.add(node);
            object.add(self.parse_expression_list("}"));
            return object;
        }

        if self.match_lexeme("[") {
            index = IndexExpr{node.line(), node.column()};
            index.add(node);
            index.add(self.parse_expression_list("]"));
            return index;
        }
        name = self.expect_identifier("Expected member name after '.'.");
        if self.match_lexeme("(") {
            method = MethodCall{name.lexeme(), name.line(), name.column()};
            method.add(node);
            method.add(self.parse_expression_list(")"));
            return method;
        }
        return MemberAccess{name.lexeme(), name.line(), name.column()}
            .add(node);
    }

    def parse_primary() -> ParseNode {
        if self.looks_like_function_literal() {
            return self.parse_function_literal();
        }
        if self.match_lexeme("(") { return self.parse_group_or_tuple(); }
        if self.match_lexeme("[") or self.match_lexeme("[]") {
            return self.parse_array_literal();
        }
        if self.match_lexeme("{") { return self.parse_dictionary_literal(); }
        if self.match_lexeme("sizeof") {
            keyword = self.previous();
            self.expect_lexeme("(", "Expected '(' after 'sizeof'.");
            node = SizeofExpr{keyword.line(), keyword.column()};
            node.add(self.parse_type());
            self.expect_lexeme(")", "Expected ')' after sizeof type.");
            return node;
        }
        if self.match_lexeme("yield") {
            keyword = self.previous();
            self.expect_lexeme("(", "Expected '(' after 'yield'.");
            node = YieldExpr{keyword.line(), keyword.column()};
            if not self.check_lexeme(")") { node.add(self.parse_expression()); }
            self.expect_lexeme(")", "Expected ')' after yield expression.");
            return node;
        }
        token = self.peek();
        is_literal = token is Literal or token.lexeme() == "true" or
            token.lexeme() == "false" or token.lexeme() == "nil";
        if is_literal {
            self.advance();
            if token is StringLiteral { return self.parse_str_lit(token); }
            return LiteralExpr{token.lexeme(), token.line(), token.column()};
        }
        if token is Field {
            self.advance();
            return FieldRef{token.lexeme(), token.line(), token.column()};
        }
        if token is Identifier {
            self.advance();
            base = Name{token.lexeme(), token.line(), token.column()};
            if not self.match_lexeme("[") { return base; }
            named = ParameterizedName{token.line(), token.column()};
            named.add(base);
            return named.add(self.parse_type_list("]"));
        }
        self.fail("Expected expression.");
        return Unreachable{};
    }

    def parse_str_lit(token : StringLiteral) -> ParseNode {
        literal = LiteralExpr{token.lexeme(), token.line(), token.column()};
        lexeme = token.lexeme();
        if lexeme.byte_length() < 2 { return literal; }
        start = 1;
        finish = lexeme.byte_length() - 1;
        text = lexeme.bytes().slice(start, finish);
        if not text.contains("\${") { return literal; }

        node = InterpolatedString{token.line(), token.column()};
        size = text.size();
        cursor = 0;
        chunk_start = 0;
        found_interp = false;
        while cursor < size {
            is_escape = text.unchecked_index(cursor) == ('\\' as i8);
            if is_escape { cursor = cursor + 2; }
            if is_escape { continue; }
            is_open = self.is_interp_open(text, cursor);
            if not is_open { cursor = cursor + 1; }
            if not is_open { continue; }

            self.add_chunk(node, text, chunk_start, cursor, token);

            expr_start = cursor + 2;
            expr_end = self.find_interp_end(text, expr_start);
            bad_interp = expr_end < 0;
            if bad_interp { self.report_unterminated_interp(token); }
            if bad_interp { return node; }

            found_interp = true;
            expr = text.slice(expr_start, expr_end).to_string();
            node.add(self.parse_string_interp(expr, token));
            cursor = expr_end + 1;
            chunk_start = cursor;
        }

        if not found_interp { return literal; }
        self.add_chunk(node, text, chunk_start, size, token);
        return node;
    }

    def find_interp_end(text : StringBytes, start : i32) -> i32 {
        size = text.size();
        depth = 1;
        cursor = start;
        while cursor < size {
            byte = text.unchecked_index(cursor);
            is_escape = byte == ('\\' as i8);
            if is_escape { cursor = cursor + 2; }
            if is_escape { continue; }
            quote_skip = self.quote_skip_target(text, cursor, byte);
            has_quote = quote_skip >= 0;
            if has_quote { cursor = quote_skip; }
            if has_quote { continue; }
            comment_skip = self.comment_skip_target(text, cursor);
            has_comment = comment_skip >= 0;
            if has_comment { cursor = comment_skip; }
            if has_comment { continue; }
            is_open = byte == ('{' as i8);
            if is_open { depth = depth + 1; }
            if is_open { cursor = cursor + 1; }
            if is_open { continue; }
            is_close = byte == ('}' as i8);
            if not is_close { cursor = cursor + 1; }
            if not is_close { continue; }
            depth = depth - 1;
            if depth == 0 { return cursor; }
            cursor = cursor + 1;
        }
        return -1;
    }

    def is_interp_open(text : StringBytes, cursor : i32) -> Bool {
        if text.unchecked_index(cursor) != ('$' as i8) { return false; }
        size = text.size();
        if cursor + 1 >= size { return false; }
        return text.unchecked_index(cursor + 1) == ('{' as i8);
    }

    def add_chunk(n : ParseNode, s : StringBytes, a : i32, b : i32, t : Token) {
        if a >= b { return; }
        chunk = s.slice(a, b).to_string();
        n.add(StringText{chunk, t.line(), t.column()});
    }

    def quote_skip_target(text : StringBytes, cursor : i32, byte : i8) -> i32 {
        if byte == ('"' as i8) {
            return self.skip_quoted(text, cursor, '"' as i8);
        }
        if byte == ('\'' as i8) {
            return self.skip_quoted(text, cursor, '\'' as i8);
        }
        return -1;
    }

    def comment_skip_target(text : StringBytes, cursor : i32) -> i32 {
        size = text.size();
        if cursor + 1 >= size { return -1; }
        if text.unchecked_index(cursor) != ('/' as i8) { return -1; }
        next = text.unchecked_index(cursor + 1);
        if next == ('/' as i8) {
            return self.skip_line_comment(text, cursor + 2);
        }
        if next == ('*' as i8) {
            return self.skip_block_comment(text, cursor + 2);
        }
        return -1;
    }

    def skip_quoted(text : StringBytes, start : i32, quote : i8) -> i32 {
        size = text.size();
        cursor = start + 1;
        while cursor < size {
            byte = text.unchecked_index(cursor);
            is_escape = byte == ('\\' as i8);
            if is_escape { cursor = cursor + 2; }
            if is_escape { continue; }
            if byte == quote { return cursor + 1; }
            cursor = cursor + 1;
        }
        return size;
    }

    def skip_line_comment(text : StringBytes, start : i32) -> i32 {
        size = text.size();
        cursor = start;
        while cursor < size {
            if text.unchecked_index(cursor) == ('\n' as i8) { return cursor; }
            cursor = cursor + 1;
        }
        return size;
    }

    def skip_block_comment(text : StringBytes, start : i32) -> i32 {
        size = text.size();
        cursor = start;
        while cursor + 1 < size {
            left = text.unchecked_index(cursor);
            right = text.unchecked_index(cursor + 1);
            is_end = left == ('*' as i8) and right == ('/' as i8);
            if is_end { return cursor + 2; }
            cursor = cursor + 1;
        }
        return size;
    }

    def parse_string_interp(expr_text : String, token : Token) -> ParseNode {
        node = StringInterp{token.line(), token.column()};
        lexer = PaulTalkLexer{expr_text};
        parser = PaulTalkParser{lexer.tokenize()};
        node.add(parser.parse_expression());
        for error in lexer.errors() {
            self.add_string_parse_error(error.message(), token);
        }
        for error in parser.errors() {
            self.add_string_parse_error(error.message(), token);
        }
        if not parser.is_at_end() {
            message = "Invalid interpolation expression.";
            self.add_string_parse_error(message, token);
        }
        return node;
    }

    def add_string_parse_error(message : String, token : Token) {
        @errors.append(ParseError{
            "In string interpolation: ${message}",
            token.line(),
            token.column()
        });
    }

    def report_unterminated_interp(token : Token) {
        message = "Unterminated string interpolation.";
        self.add_string_parse_error(message, token);
    }

    def parse_function_literal() -> ParseNode {
        open = self.expect_lexeme("(", "Expected '(' for function literal.");
        node = FunctionLiteral{open.line(), open.column()};
        node.add(self.parse_parameter_list(false));
        self.expect_lexeme(")", "Expected ')' after function literal params.");
        if self.match_lexeme("yields") { node.add(self.parse_type()); }
        self.expect_lexeme("=>", "Expected '=>' after function literal.");
        node.add(self.parse_block());
        return node;
    }

    def parse_group_or_tuple() -> ParseNode {
        open = self.previous();
        if self.match_lexeme(")") {
            return TupleLiteral{open.line(), open.column()};
        }
        first = self.parse_expression();
        if not self.match_lexeme(",") {
            self.expect_lexeme(")", "Expected ')' after grouped expression.");
            node = GroupExpr{open.line(), open.column()};
            return node.add(first);
        }
        node = TupleLiteral{open.line(), open.column()};
        node.add(first);
        node.add(self.parse_expression());
        while self.match_lexeme(",") { node.add(self.parse_expression()); }
        self.expect_lexeme(")", "Expected ')' after tuple literal.");
        return node;
    }

    def parse_array_literal() -> ParseNode {
        open = self.previous();
        node = ArrayLiteral{open.line(), open.column()};
        has_close = open.lexeme() == "[]";
        if not has_close and not self.check_lexeme("]") {
            self.parse_expression_sequence(node, "]");
        }
        if not has_close {
            self.expect_lexeme("]", "Expected ']' after array literal.");
        }
        if self.match_lexeme("of") { node.add(ElementType{}.add(self.parse_type())); }
        return node;
    }

    def parse_dictionary_literal() -> ParseNode {
        open = self.previous();
        node = DictionaryLiteral{open.line(), open.column()};
        if self.match_lexeme("}") { return node; }
        key = self.parse_expression();
        self.expect_lexeme(":", "Expected ':' in dictionary key/value pair.");
        value = self.parse_expression();
        pair = KvPair{key.line(), key.column()};
        node.add(pair.add(key).add(value));
        while self.match_lexeme(",") and not self.check_lexeme("}") {
            key = self.parse_expression();
            message = "Expected ':' in dictionary key/value pair.";
            self.expect_lexeme(":", message);
            value = self.parse_expression();
            pair = KvPair{key.line(), key.column()};
            node.add(pair.add(key).add(value));
        }
        self.expect_lexeme("}", "Expected '}' after dictionary literal.");
        return node;
    }

    def parse_expression_list(terminator : String) -> ParseNode {
        node = ExpressionList{terminator};
        if not self.check_lexeme(terminator) {
            self.parse_expression_sequence(node, terminator);
        }
        self.expect_lexeme(terminator, "Expected expression list delimiter.");
        return node;
    }

    def parse_expression_sequence(node : ParseNode, terminator : String) {
        node.add(self.parse_expression());
        while self.match_lexeme(",") and not self.check_lexeme(terminator) {
            node.add(self.parse_expression());
        }
    }

    def parse_type() -> ParseNode {
        left = self.parse_nilable_type();
        while self.match_lexeme("|") {
            op = self.previous();
            right = self.parse_nilable_type();
            left = UnionType{op.lexeme(), op.line(), op.column()}.add(left).add(right);
        }
        return left;
    }

    def parse_nilable_type() -> ParseNode {
        node = self.parse_type_primary();
        while self.match_lexeme("?") {
            op = self.previous();
            wrapped = NilableType{op.lexeme(), op.line(), op.column()};
            wrapped.add(node);
            node = wrapped;
        }
        return node;
    }

    def parse_type_primary() -> ParseNode {
        if self.match_lexeme("(") { return self.parse_parenthesized_type(); }

        base = self.parse_named_type();
        if not self.match_lexeme("[") { return base; }
        return ParameterizedType{base.line(), base.column()}
            .add(base)
            .add(self.parse_type_list("]"));
    }

    def parse_named_type() -> ParseNode {
        name = self.expect_identifier("Expected type name.");
        if not self.check_lexeme(".") {
            return NamedType{name.lexeme(), name.line(), name.column()};
        }

        text = name.lexeme().copy();
        qualified = name is not TypeIdentifier;
        while self.match_lexeme(".") {
            next = self.expect_identifier("Expected type name after '.'.");
            text.extend(".").extend(next.lexeme());
            dotted = self.check_lexeme(".");
            if dotted and next is TypeIdentifier { qualified = false; }
            if dotted { continue; }
            if next is not TypeIdentifier { qualified = false; }
        }
        if not qualified {
            self.fail("Qualified type names must end in a capitalized segment.");
        }
        return NamedType{text, name.line(), name.column()};
    }

    def parse_parenthesized_type() -> ParseNode {
        open = self.previous();
        params = TypeList{};
        if not self.check_lexeme(")") {
            params.add(self.parse_type());
            while self.match_lexeme(",") { params.add(self.parse_type()); }
        }
        self.expect_lexeme(")", "Expected ')' in type expression.");
        if not self.match_lexeme("->") and not self.match_lexeme("yields") {
            grouped = GroupedType{open.line(), open.column()};
            return grouped.add(params);
        }
        node = FunctionType{open.line(), open.column()};
        node.add(params);
        if self.previous().lexeme() == "->" {
            node.add(self.parse_type());
            if self.match_lexeme("yields") { node.add(self.parse_type()); }
            return node;
        }
        node.add(self.parse_type());
        return node;
    }

    def parse_type_list(terminator : String) -> ParseNode {
        node = TypeList{terminator};
        if self.check_lexeme(terminator) {
            self.expect_lexeme(terminator, "Expected type list delimiter.");
            return node;
        }
        has_count = self.peek() is IntLiteral;
        if has_count { has_count = self.token_at(@cursor + 1).lexeme() == "x"; }
        if has_count {
            count = self.advance();
            self.advance();
            counted = TypeCount{count.lexeme(), count.line(), count.column()};
            counted.add(self.parse_type());
            node.add(counted);
            self.expect_lexeme(terminator, "Expected type list delimiter.");
            return node;
        }
        node.add(self.parse_type());
        while self.match_lexeme(",") and not self.check_lexeme(terminator) {
            node.add(self.parse_type());
        }
        self.expect_lexeme(terminator, "Expected type list delimiter.");
        return node;
    }

    def parse_parameters(node : ParseNode, allow_fields : Bool) {
        self.expect_lexeme("(", "Expected '(' in callable signature.");
        node.add(self.parse_parameter_list(allow_fields));
        self.expect_lexeme(")", "Expected ')' after callable parameters.");
        if self.match_lexeme("->") { node.add(self.parse_type()); }
        if self.match_lexeme("yields") { node.add(self.parse_type()); }
    }

    def parse_optional_generic_parameters(node : ParseNode) {
        if not self.match_lexeme("[") { return; }
        generics = GenericParams{};
        generic_message = "Expected generic type variable.";
        if self.match_lexeme("]") {
            node.add(generics);
            return;
        }
        token = self.expect_identifier(generic_message);
        generics.add(Name{token.lexeme(), token.line(), token.column()});
        while self.match_lexeme(",") {
            token = self.expect_identifier(generic_message);
            generics.add(Name{token.lexeme(), token.line(), token.column()});
        }
        self.expect_lexeme("]", "Expected ']' after generic parameters.");
        node.add(generics);
    }

    def parse_parameter_list(allow_field_params : Bool) -> ParseNode {
        params = Params{};
        while not self.check_lexeme(")") {
            params.add(self.parse_parameter(allow_field_params));
            if not self.match_lexeme(",") { break; }
        }
        return params;
    }

    def parse_parameter(allow_field_params : Bool) -> ParseNode {
        token = self.peek();
        allow_field = allow_field_params and token is Field;
        if allow_field { self.advance(); }
        name = token;
        if not allow_field { name = self.expect_identifier("Expected param"); }
        self.expect_lexeme(":", "Expected ':' in parameter declaration.");
        param = Param{name.lexeme(), name.line(), name.column()};
        return param.add(self.parse_type());
    }

    def parse_optional_constraints(node : ParseNode) {
        if not self.match_lexeme("~>") { return; }
        token = self.previous();
        constraints = Constraints{token.line(), token.column()};
        constraints.add(self.parse_constraint_list("Expected constraints."));
        node.add(constraints);
    }

    def parse_constraint_list(message : String) -> ParseNode {
        if self.match_lexeme("no_alias") or self.match_lexeme("all_alias") {
            token = self.previous();
            return ConstraintAtom{token.lexeme(), token.line(), token.column()};
        }
        open = self.expect_lexeme("{", message);
        list_node = ConstraintList{open.line(), open.column()};
        if self.match_lexeme("}") { return list_node; }
        list_node.add(self.parse_constraint());
        while self.match_lexeme(",") and not self.check_lexeme("}") {
            list_node.add(self.parse_constraint());
        }
        self.expect_lexeme("}", "Expected '}' after constraint list.");
        return list_node;
    }

    def parse_constraint() -> ParseNode {
        if self.check_lexeme("(") {
            left_many = self.parse_parenthesized_region_variable_list();
            holds_token = self.expect_lexeme("holds", "Expected 'holds'.");
            right = self.parse_region_variable();
            node = ManyHolds{holds_token.line(), holds_token.column()};
            return self.pair(node, left_many, right);
        }
        left = self.parse_region_variable();
        if self.match_lexeme("holds") {
            holds_token = self.previous();
            needs_one = not self.check_lexeme("(");
            if needs_one { return self.make_holds_one(holds_token, left); }
            many = self.parse_parenthesized_region_variable_list();
            holds_many = HoldsMany{holds_token.line(), holds_token.column()};
            return self.pair(holds_many, left, many);
        }
        eq = self.expect_lexeme("==", "Expected 'holds' or '=='.");
        chain = EqualityChain{eq.lexeme(), eq.line(), eq.column()};
        chain.add(left);
        chain.add(self.parse_region_variable());
        while self.match_lexeme("==") {
            chain.add(self.parse_region_variable());
        }
        return chain;
    }

    def make_holds_one(holds_token : Token, left : ParseNode) -> ParseNode {
        right = self.parse_region_variable();
        holds_one = HoldsOne{holds_token.line(), holds_token.column()};
        return self.pair(holds_one, left, right);
    }

    def pair(node : ParseNode, left : ParseNode, right : ParseNode) -> ParseNode {
        return node.add(left).add(right);
    }

    def parse_parenthesized_region_variable_list() -> ParseNode {
        open = self.expect_lexeme("(", "Expected '(' for region vars.");
        list_node = RegionVars{open.line(), open.column()};
        list_node.add(self.parse_region_variable());
        while self.match_lexeme(",") {
            list_node.add(self.parse_region_variable());
        }
        self.expect_lexeme(")", "Expected ')' after region variable list.");
        return list_node;
    }

    def parse_region_variable() -> ParseNode {
        segment = self.expect_region_segment("Expected region variable.");
        node = RegionVar{segment.line(), segment.column()};
        node.add(Segment{segment.lexeme(), segment.line(), segment.column()});
        while self.add_region_tail(node) {}
        return node;
    }

    def add_region_tail(node : RegionVar) -> Bool {
        if self.match_lexeme(".") {
            next_segment = self.expect_region_segment("Expected identifier.");
            self.add_region_segment(node, next_segment);
            return true;
        }
        if self.peek() is not RegionName { return false; }
        next_segment = self.expect_region_name("Expected region name.");
        self.add_region_segment(node, next_segment);
        return true;
    }

    def add_region_segment(node : RegionVar, next_segment : Token) {
        text = next_segment.lexeme();
        line = next_segment.line();
        col = next_segment.column();
        node.add(Segment{text, line, col});
    }

    def looks_like_function_literal() -> Bool {
        if not self.check_lexeme("(") { return false; }
        closing = nil;
        depth = 0;
        index = @cursor;
        while index < @tokens.size() {
            token = self.token_at(index);
            if token.lexeme() == "(" { depth = depth + 1; }
            if token.lexeme() == ")" { depth = depth - 1; }
            if token.lexeme() == ")" and depth == 0 { closing = index; }
            if closing is i32 { break; }
            index = index + 1;
        }
        if closing is not i32 { return false; }
        next = self.token_at(closing + 1);
        if next.lexeme() == "=>" { return true; }
        if next.lexeme() != "yields" { return false; }

        probe = closing + 2;
        while probe < @tokens.size() {
            token = self.token_at(probe);
            if token.lexeme() == "=>" { return true; }
            if token.lexeme() == "{" or token.lexeme() == ";" { return false; }
            probe = probe + 1;
        }
        return false;
    }

    def token_at(index : i32) -> Token {
        if index < 0 { return @tokens.[0]; }
        if index >= @tokens.size() { return @tokens.[@tokens.size() - 1]; }
        return @tokens.[index];
    }

    def peek() -> Token { return self.token_at(@cursor); }

    def previous() -> Token { return self.token_at(@cursor - 1); }

    def is_at_end() -> Bool { return self.peek() is EOF; }

    def advance() -> Token {
        token = self.peek();
        if not self.is_at_end() { @cursor = @cursor + 1; }
        return token;
    }

    def check_lexeme(lexeme : String) -> Bool {
        if self.is_at_end() { return false; }
        return self.peek().lexeme() == lexeme;
    }

    def match_lexeme(lexeme : String) -> Bool {
        if not self.check_lexeme(lexeme) { return false; }
        self.advance();
        return true;
    }

    def match_any(lexemes : Array[String]) -> Bool {
        for lexeme in lexemes { if self.match_lexeme(lexeme) { return true; } }
        return false;
    }

    def check_any_lexeme(lexemes : Array[String]) -> Bool {
        for lexeme in lexemes { if self.check_lexeme(lexeme) { return true; } }
        return false;
    }

    def ensure_progress(start : i32) {
        if @cursor != start { return; }
        if self.is_at_end() { return; }
        self.advance();
    }

    def consume_semicolon() -> Bool {
        if not self.check_lexeme(";") { return false; }
        self.advance();
        return true;
    }

    def synchronize_statement() {
        starters = [
            "import", "export", "no_export", "alias", "extern", "def",
            "class", "if", "while", "for", "return", "break",
            "continue", "{"
        ];
        while not self.is_at_end() {
            if self.consume_semicolon() { return; }
            if self.check_lexeme("}") { return; }
            if self.check_any_lexeme(starters) { return; }
            self.advance();
        }
    }

    def synchronize_class_member() {
        member_starters = ["regions", "getter", "setter", "getters", "setters"];
        member_starters_2 = ["abstract", "def"];
        while not self.is_at_end() {
            if self.check_lexeme("}") { return; }
            if self.peek() is Field { return; }
            if self.peek() is RegionName { return; }
            if self.check_any_lexeme(member_starters) { return; }
            if self.check_any_lexeme(member_starters_2) { return; }
            if self.consume_semicolon() { return; }
            self.advance();
        }
    }

    def expect_lexeme(lexeme : String, message : String) -> Token {
        if self.check_lexeme(lexeme) { return self.advance(); }
        return self.fail_token(message, "<missing>");
    }

    def expect_identifier(message : String) -> Token {
        if self.peek() is Identifier { return self.advance(); }
        return self.fail_token(message, "<identifier>");
    }

    def expect_field(message : String) -> Token {
        if self.peek() is Field { return self.advance(); }
        return self.fail_token(message, "<field>");
    }

    def expect_region_name(message : String) -> Token {
        if self.peek() is RegionName { return self.advance(); }
        return self.fail_token(message, "<region_name>");
    }

    def expect_region_segment(message : String) -> Token {
        token = self.peek();
        if token is Field or token is Identifier or token is RegionName {
            return self.advance();
        }
        return self.fail_token(message, "<region>");
    }

    def expect_method_name() -> Token {
        token = self.peek();
        if token is Field or token is Identifier {
            self.advance();
            return token;
        }
        is_operator = token is Symbol and
            self.is_method_operator_lexeme(token.lexeme());
        if is_operator {
            self.advance();
            return token;
        }
        return self.fail_token("Expected method/operator name.", "<method>");
    }

    def fail_token(message : String, fallback : String) -> Token {
        self.fail(message);
        return EOF{fallback, 0, 0};
    }

    def is_method_operator_lexeme(text : String) -> Bool {
        operators = ["+","-","*","/","==","!=","<=",">=","<",">","[]","[]="];
        for op in operators { if op == text { return true; }}
        return false;
    }

    def fail(message : String) {
        token = self.peek();
        if @cursor == @last_error_cursor { return; }
        @last_error_cursor = @cursor;
        @errors.append(ParseError{message, token.line(), token.column()});
    }
}

def parse_paultalk_resilient(source : String) -> ParseResult {
    lexer = PaulTalkLexer{source};
    tokens = lexer.tokenize();
    parser = PaulTalkParser{tokens};
    tree = parser.parse_program();
    errors = [] of ParseError;
    for err in lexer.errors() { errors.append(err); }
    for err in parser.errors() { errors.append(err); }
    return ParseResult{tree, errors};
}

def parse_paultalk(source : String) -> ParseNode {
    return parse_paultalk_resilient(source).tree();
}

def parse_paultalk_strict(source : String) -> ParseNode {
    result = parse_paultalk_resilient(source);
    if result.has_errors() { yield(result.errors().[0]); }
    return result.tree();
}

def serialize_parse_tree(node : ParseNode) -> String {
    return node.tree_string();
}
