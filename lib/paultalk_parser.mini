import std;

class ParseError extends Exception {
    @line : i32
    @column : i32

    getters @line, @column

    def init(message : String, @line : i32, @column : i32) {
        @message = message;
        @line_number = @line;
        @file_name = "<paultalk_parser>";
        @stacktrace = Stacktrace{};
    }

    def print_message() {
        print(self.header());
    }

    def message() -> String { return @message; }

    def header() -> String {
        return "Parse error at line ${@line}, column ${@column}: ${@message}";
    }

    def format(source : String) -> String {
        return format_parse_error(source, self);
    }
}

class Token extends Representable {
    @lexeme : String
    @line : i32
    @column : i32

    getters @lexeme, @line, @column

    def init(@lexeme : String, @line : i32, @column : i32) {
    }

    def is_lexeme(text : String) -> Bool { return @lexeme == text; }

    def repr() -> String { return @lexeme; }
}

class EOF extends Token {}
class Identifier extends Token {}
class TypeIdentifier extends Identifier {}
class Field extends Token {}
class RegionName extends Token {}
class Literal extends Token {}
class IntLiteral extends Literal {}
class FloatLiteral extends Literal {}
class HexLiteral extends Literal {}
class StringLiteral extends Literal {}
class CharLiteral extends Literal {}
class Keyword extends Token {}
class Symbol extends Token {}

def starts_with_upper(text : String) -> Bool {
    if text.byte_length() == 0 { return false; }
    first = text.unchecked_index(0);
    return first >= ('A' as i8) and first <= ('Z' as i8);
}

class ParseNode extends Representable {
    @value : String
    @line : i32
    @column : i32
    @children : Array[ParseNode]

    getters @value, @line, @column, @children

    def init(@value : String, @line : i32, @column : i32) {
        @children = [] of ParseNode;
    }
    def init(@line : i32, @column : i32) {
        @value = "";
        @children = [] of ParseNode;
    }
    def init(@value : String) {
        @line = 0;
        @column = 0;
        @children = [] of ParseNode;
    }
    def init() {
        @value = "";
        @line = 0;
        @column = 0;
        @children = [] of ParseNode;
    }

    def name() -> String { return "node"; }

    def add(child : ParseNode) -> Self {
        @children.append(child);
        return self;
    }

    def repr() -> String {
        name = self.name();
        if @value.byte_length() == 0 { return name; }
        return "${name}(${@value})";
    }

    def tree_string() -> String {
        out = "";
        self.append_tree(out, 0);
        return out;
    }

    def append_tree(out : String, depth : i32) {
        self.append_indent(out, depth);
        out.extend(self.repr());
        count = @children.size();
        if count == 0 { return; }
        out.extend("\n");
        i = 0;
        while i < count {
            @children.[i].append_tree(out, depth + 1);
            i = i + 1;
            if i < count { out.extend("\n"); }
        }
    }

    def append_indent(out : String, depth : i32) {
        for i in 0..depth { out.extend("  "); }
    }

    def is_assignable() -> Bool { return self is Assignable; }

    def is_object_creation_target() -> Bool { return false; }

    def can_parameterize() -> Bool { return false; }
}

