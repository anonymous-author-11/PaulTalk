import builtins;
import writer;
import peek;
import exception;
import string;

no_export exception;
no_export string;

class Unicode {

    def Self.is_valid_codepoint(codepoint : i32) -> Bool {
        return codepoint >= 0 and codepoint <= 0x10FFFF;
    }

	def Self.is_valid_scalar(scalar : i32) -> Bool {
		if not Unicode.is_valid_codepoint(scalar) { return false; }
		return scalar < 0xD800 or scalar > 0xDFFF;
	}

	def Self.replacement_codepoint() -> i32 {
        return 0xFFFD as i32;
    }
}

class UnicodeValidator extends Iterator[i32] {
    @iterator : Iterator[i32]
    @replacer : (i32) -> i32

    regions { $elems == @iterator$elems }

    getters @iterator, @replacer
    setter @replacer

    def init(@iterator : Iterator[i32]) {
        @replacer = (codepoint : i32) => { yield(InvalidUnicodeError{}); return -1; };
    }

    def init(@iterator : Iterator[i32], @replacer : (i32) -> i32) {}

    abstract def is_valid(codepoint : i32) -> Bool ~> no_alias

    def next() -> i32? {
        codepoint = @iterator.next();
        if codepoint is Nil { return nil; }
        if self.is_valid(codepoint) { return codepoint; }
        return @replacer.call(codepoint);
    }
}

class CodepointValidator extends UnicodeValidator {

    def Self.lossy(iterator : Iterator[i32]) -> CodepointValidator {
        replacer = (codepoint : i32) => { Unicode.replacement_codepoint(); };
        return CodepointValidator{iterator, replacer};
    } ~> { ret.iterator == iterator }

    def is_valid(codepoint : i32) -> Bool {
        return Unicode.is_valid_codepoint(codepoint);
    }
}

class ScalarValidator extends UnicodeValidator {

    def Self.lossy(iterator : Iterator[i32]) -> ScalarValidator {
        replacer = (codepoint : i32) => { Unicode.replacement_codepoint(); };
        return ScalarValidator{iterator, replacer};
    } ~> { ret.iterator == iterator }
    
    def is_valid(codepoint : i32) -> Bool {
        return Unicode.is_valid_scalar(codepoint);
    }
}

class UnicodeEncoder extends Writer[i32] {
    @writer : Writer[i8]
    @replacer : (Writer[i8])

    regions { $dest == @writer$dest }

    getter @replacer
    setter @replacer

    abstract def encoded_width(codepoint : i32) -> i32 ~> no_alias

}