import unicode16;

// Encoders

// Written i32s should be valid scalars
// Written bytes are valid surrogate pairs
class UTF16Encoder extends Unicode16Encoder {

    def encoded_width(codepoint : i32) -> i32 {
        if not Unicode.is_valid_scalar(codepoint) { return 0; }
        if codepoint < 0x10000 { return 1; }
        return 2;
    }
}

class UTF16EncoderLE extends UTF16Encoder, Unicode16EncoderLE {

    def Self.lossy(writer : Writer[i8]) -> UTF16EncoderLE {
        return UTF16EncoderLE{writer, Unicode16EncoderLE.lossy_replacer()};
    }
}

class UTF16EncoderBE extends UTF16Encoder, Unicode16EncoderBE {

    def Self.lossy(writer : Writer[i8]) -> UTF16EncoderBE {
        return UTF16EncoderBE{writer, Unicode16EncoderBE.lossy_replacer()};
    }
}

// Decoders

class UTF16Decoder extends Unicode16Decoder {

    def invalid_standalone(unit : u16) -> Bool {
        return Unicode16.is_low_surrogate(unit);
    }
    def unpaired_result(unit : u16) -> i32? {
        return @replacer.call(unit);
    }
}

class UTF16DecoderLE extends UTF16Decoder, Unicode16DecoderLE {

    def Self.lossy(iterator : Iterator[i8]) -> UTF16DecoderLE {
        return UTF16DecoderLE{iterator, Unicode16Decoder.lossy_replacer()};
    }
}

class UTF16DecoderBE extends UTF16Decoder, Unicode16DecoderBE {

    def Self.lossy(iterator : Iterator[i8]) -> UTF16DecoderBE {
        return UTF16DecoderBE{iterator, Unicode16Decoder.lossy_replacer()};
    }
}
