import std;
import old_hashmaps.hash_perf_utils;
import old_hashmaps.swiss_table_v5;
import swiss.swiss_map;

alias TableOne = swiss.swiss_map.SwissMap;
alias TableTwo = old_hashmaps.swiss_table_v5.SwissTable;

def table_one() -> String { return "SwissMap"; }

def table_two() -> String { return "SwissTableV5"; }

extern def clock() -> i64

def pass_label(passed : Bool) -> String {
    if passed { return "PASS"; }
    return "FAIL";
}

def print_result(case_name : String, order : String, name : String, n : i32, ms : i64, ok : Bool) {
    IO.print("RESULT|${case_name}|${order}|${name}|${n}|${ms}|${pass_label(ok)}");
}

def make_keys(n : i32) -> Array[i32] {
    return 0..n into Array;
}

def make_shifted_keys(n : i32, shift : i32) -> Array[i32] {
    keys = Array[i32].new(n);
    for i in 0..n { keys.put_unchecked(i, i + shift); }
    return keys;
}

def shuffled_keys(n : i32, seed : i32) -> Array[i32] {
    keys = make_keys(n);
    shuffle_i32(keys, n, PRNG.new(seed));
    return keys;
}

def inserted_sum(n : i32) -> i64 {
    sum : i64 = 0;
    for i in 0..n { sum = sum + (i + 1); }
    return sum;
}

def bench_insert_sequential_v4(n : i32, order : String) {
    map = TableTwo[i32, i32].new(i32_hasher, i32_eq);
    start_ms = clock();
    for i in 0..n { map.insert(i, i + 1); }
    ms = clock() - start_ms;
    last = map.get(n - 1);
    ok = n == 0;
    if n > 0 {
        ok = map.size() == n;
        if last is not i32 { ok = false; }
        if last is i32 {
            if last != n { ok = false; }
        }
    }
    print_result("Insert Sequential", order, "${table_two()}", n, ms, ok);
}

def bench_insert_sequential_keyed(n : i32, order : String) {
    map = TableOne[i32, i32].new(i32_hasher, i32_eq);
    start_ms = clock();
    for i in 0..n {
        map.insert(i, i + 1);
    }
    ms = clock() - start_ms;
    last = map.get(n - 1);
    ok = n == 0;
    if n > 0 {
        ok = map.size() == n;
        if last is not i32 { ok = false; }
        if last is i32 {
            if last != n { ok = false; }
        }
    }
    print_result("Insert Sequential", order, "${table_one()}", n, ms, ok);
}

def bench_insert_random_v4(keys : Array[i32], n : i32, order : String) {
    map = TableTwo[i32, i32].new(i32_hasher, i32_eq);
    start_ms = clock();
    for i in 0..n {
        key = keys.get_unchecked(i);
        map.insert(key, key + 1);
    }
    ms = clock() - start_ms;
    sample = map.get(12345);
    ok = map.size() == n;
    if sample is not i32 { ok = false; }
    if sample is i32 {
        if sample != 12346 { ok = false; }
    }
    print_result("Insert Random", order, "${table_two()}", n, ms, ok);
}

def bench_insert_random_keyed(keys : Array[i32], n : i32, order : String) {
    map = TableOne[i32, i32].new(i32_hasher, i32_eq);
    start_ms = clock();
    for i in 0..n {
        key = keys.get_unchecked(i);
        map.insert(key, key + 1);
    }
    ms = clock() - start_ms;
    sample = map.get(12345);
    ok = map.size() == n;
    if sample is not i32 { ok = false; }
    if sample is i32 {
        if sample != 12346 { ok = false; }
    }
    print_result("Insert Random", order, "${table_one()}", n, ms, ok);
}

def bench_get_sequential_v4(n : i32, expected_sum : i64, order : String) {
    map = TableTwo[i32, i32].new(i32_hasher, i32_eq);
    for i in 0..n {
        map.insert(i, i + 1);
    }
    sum : i64 = 0;
    start_ms = clock();
    for i in 0..n {
        value = map.get(i);
        if value is i32 { sum = sum + value; }
    }
    ms = clock() - start_ms;
    print_result("Get Sequential", order, "${table_two()}", n, ms, sum == expected_sum);
}

def bench_get_sequential_keyed(n : i32, expected_sum : i64, order : String) {
    map = TableOne[i32, i32].new(i32_hasher, i32_eq);
    for i in 0..n {
        map.insert(i, i + 1);
    }
    sum : i64 = 0;
    start_ms = clock();
    for i in 0..n {
        value = map.get(i);
        if value is i32 { sum = sum + value; }
    }
    ms = clock() - start_ms;
    print_result("Get Sequential", order, "${table_one()}", n, ms, sum == expected_sum);
}

def bench_get_random_v4(ins : Array[i32], look : Array[i32], n : i32, exp : i64, ord : String) {
    map = TableTwo[i32, i32].new(i32_hasher, i32_eq);
    for i in 0..n {
        key = ins.get_unchecked(i);
        map.insert(key, key + 1);
    }
    sum : i64 = 0;
    start_ms = clock();
    for i in 0..n {
        key = look.get_unchecked(i);
        value = map.get(key);
        if value is i32 { sum = sum + value; }
    }
    ms = clock() - start_ms;
    print_result("Get Random", ord, "${table_two()}", n, ms, sum == exp);
}

def bench_get_random_keyed(ins : Array[i32], look : Array[i32], n : i32, exp : i64, ord : String) {
    map = TableOne[i32, i32].new(i32_hasher, i32_eq);
    for i in 0..n {
        key = ins.get_unchecked(i);
        map.insert(key, key + 1);
    }
    sum : i64 = 0;
    start_ms = clock();
    for i in 0..n {
        key = look.get_unchecked(i);
        value = map.get(key);
        if value is i32 { sum = sum + value; }
    }
    ms = clock() - start_ms;
    print_result("Get Random", ord, "${table_one()}", n, ms, sum == exp);
}

def bench_get_miss_v4(insert_keys : Array[i32], miss_keys : Array[i32], n : i32, order : String) {
    map = TableTwo[i32, i32].new(i32_hasher, i32_eq);
    for i in 0..n {
        key = insert_keys.get_unchecked(i);
        map.insert(key, key + 1);
    }
    misses = 0;
    start_ms = clock();
    for i in 0..n {
        key = miss_keys.get_unchecked(i);
        if map.get(key) is Nil { misses = misses + 1; }
    }
    ms = clock() - start_ms;
    print_result("Get Miss", order, "${table_two()}", n, ms, misses == n);
}

def bench_get_miss_keyed(ins : Array[i32], miss : Array[i32], n : i32, order : String) {
    map = TableOne[i32, i32].new(i32_hasher, i32_eq);
    for i in 0..n {
        key = ins.get_unchecked(i);
        map.insert(key, key + 1);
    }
    misses = 0;
    start_ms = clock();
    for i in 0..n {
        key = miss.get_unchecked(i);
        if map.get(key) is Nil { misses = misses + 1; }
    }
    ms = clock() - start_ms;
    print_result("Get Miss", order, "${table_one()}", n, ms, misses == n);
}

def bench_remove_random_v4(ins : Array[i32], rem : Array[i32], n : i32, order : String) {
    map = TableTwo[i32, i32].new(i32_hasher, i32_eq);
    for i in 0..n {
        key = ins.get_unchecked(i);
        map.insert(key, key + 1);
    }
    removed = 0;
    start_ms = clock();
    for i in 0..n {
        key = rem.get_unchecked(i);
        value = map.remove(key);
        if value is i32 { removed = removed + 1; }
    }
    ms = clock() - start_ms;
    ok = removed == n and map.size() == 0;
    print_result("Remove Random", order, "${table_two()}", n, ms, ok);
}

def bench_remove_random_keyed(ins : Array[i32], rem : Array[i32], n : i32, order : String) {
    map = TableOne[i32, i32].new(i32_hasher, i32_eq);
    for i in 0..n {
        key = ins.get_unchecked(i);
        map.insert(key, key + 1);
    }
    removed = 0;
    start_ms = clock();
    for i in 0..n {
        key = rem.get_unchecked(i);
        value = map.remove(key);
        if value is i32 { removed = removed + 1; }
    }
    ms = clock() - start_ms;
    ok = removed == n and map.size() == 0;
    print_result("Remove Random", order, "${table_one()}", n, ms, ok);
}

def run_forward(n : i32) {
    insert_random_keys = shuffled_keys(n, 777);
    random_insert_keys = shuffled_keys(n, 111);
    random_lookup_keys = shuffled_keys(n, 222);
    miss_insert_keys = shuffled_keys(n, 333);
    miss_keys = make_shifted_keys(n, n);
    remove_insert_keys = shuffled_keys(n, 555);
    remove_keys = shuffled_keys(n, 666);
    expected_sum = inserted_sum(n);

    shuffle_i32(miss_keys, n, PRNG.new(444));

    bench_insert_sequential_v4(n, "forward");
    bench_insert_sequential_keyed(n, "forward");
    bench_insert_random_v4(insert_random_keys, n, "forward");
    bench_insert_random_keyed(insert_random_keys, n, "forward");
    bench_get_sequential_v4(n, expected_sum, "forward");
    bench_get_sequential_keyed(n, expected_sum, "forward");
    bench_get_random_v4(random_insert_keys, random_lookup_keys, n, expected_sum, "forward");
    bench_get_random_keyed(random_insert_keys, random_lookup_keys, n, expected_sum, "forward");
    bench_get_miss_v4(miss_insert_keys, miss_keys, n, "forward");
    bench_get_miss_keyed(miss_insert_keys, miss_keys, n, "forward");
    bench_remove_random_v4(remove_insert_keys, remove_keys, n, "forward");
    bench_remove_random_keyed(remove_insert_keys, remove_keys, n, "forward");
}

def run_reverse(n : i32) {
    insert_random_keys = shuffled_keys(n, 777);
    random_insert_keys = shuffled_keys(n, 111);
    random_lookup_keys = shuffled_keys(n, 222);
    miss_insert_keys = shuffled_keys(n, 333);
    miss_keys = make_shifted_keys(n, n);
    remove_insert_keys = shuffled_keys(n, 555);
    remove_keys = shuffled_keys(n, 666);
    expected_sum = inserted_sum(n);

    shuffle_i32(miss_keys, n, PRNG.new(444));

    bench_insert_sequential_keyed(n, "reverse");
    bench_insert_sequential_v4(n, "reverse");
    bench_insert_random_keyed(insert_random_keys, n, "reverse");
    bench_insert_random_v4(insert_random_keys, n, "reverse");
    bench_get_sequential_keyed(n, expected_sum, "reverse");
    bench_get_sequential_v4(n, expected_sum, "reverse");
    bench_get_random_keyed(random_insert_keys, random_lookup_keys, n, expected_sum, "reverse");
    bench_get_random_v4(random_insert_keys, random_lookup_keys, n, expected_sum, "reverse");
    bench_get_miss_keyed(miss_insert_keys, miss_keys, n, "reverse");
    bench_get_miss_v4(miss_insert_keys, miss_keys, n, "reverse");
    bench_remove_random_keyed(remove_insert_keys, remove_keys, n, "reverse");
    bench_remove_random_v4(remove_insert_keys, remove_keys, n, "reverse");
}

IO.print("COMPARE|${table_two()}|${table_one()}|forward|reverse");
n = 1_700_000;

run_forward(n);
run_reverse(n);
