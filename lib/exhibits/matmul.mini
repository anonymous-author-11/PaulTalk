import std;

// records time in milliseconds
extern def clock() -> i64

// compiles to:
// define i32 @min(i32 %0, i32 %1) {
//   %3 = call i32 @llvm.smin.i32(i32 %0, i32 %1)
//   ret i32 %3
// }
def min(a : i32, b : i32) -> i32 {
    if a < b { return a; }
    return b;
}

// compiles to:
// define <8 x double> @simd_add(<8 x double> %0, <8 x double> %1) {
//   %3 = add <8 x double> %1, %0
//   ret <8 x double> %3
// }
def simd_add(a : Tuple[8 x f64], b : Tuple[8 x f64]) -> Tuple[8 x f64] {
    return a + b;
}

// compiles to:
// define <8 x double> @simd_mul(<8 x double> %0, <8 x double> %1) {
//   %3 = mul <8 x double> %1, %0
//   ret <8 x double> %3
// }
def simd_mul(a : Tuple[8 x f64], b : Tuple[8 x f64]) -> Tuple[8 x f64] {
    return a * b;
}

class Matrix {
    @data : Buffer[f64]
    @rows : i32
    @cols : i32

    def init(@rows : i32, @cols : i32) {
        @data = Buffer[f64].new(@rows * @cols);
    }

    def data() -> Buffer[f64] { return @data; }
    def rows() -> i32 { return @rows; }
    def cols() -> i32 { return @cols; }
    
    def row_idx() -> Range { return 0..@rows; }
    def col_idx() -> Range { return 0..@cols; }

    // Because overflow *is defined*, it's imperative to cast to i64 *before* computing indices
    def [](row : i32, col : i32) -> f64 {
        index = (col as i64) * @rows + row;
        return @data.[index];
    }

    def []=(row : i32, col : i32, value : f64) {
        index = (col as i64) * @rows + row;
        @data.[index] = value;
    }

    // relevant IR:
    // %24 = load <8 x double>, ptr %23, align 8
    // ret <8 x double> %24
    def get_simd(start_row : i32, col : i32) -> Tuple[8 x f64] {
        start_index = col * @rows + start_row;
        return @data.[8 from start_index]; 
    }

    // relevant IR:
    // %25 = getelementptr i8, ptr %.fca.0.extract, i64 %24
    // store <8 x double> %5, ptr %25, align 8
    def set_simd(start_row : i32, col : i32, values : Tuple[8 x f64]) {
        start_index = col * @rows + start_row;
        @data.[8 from start_index] = values;
    }

    def *(other : Matrix) -> Matrix {
        return MatMul{self, other}.run();
    }
}

class MatMul {
    @a : Matrix
    @b : Matrix
    @result : Matrix

    getters @a, @b, @result

    // A subtype could override this
    def Self.block_size() -> i32 { return 64; }

    def init(@a : Matrix, @b : Matrix) {
        if @a.cols() != @b.rows() { yield(Exception{}); }
        @result = Matrix.new(@a.rows(), @b.cols());
    }

    def run() -> Matrix {
        bs = Self.block_size();
        m = @a.rows();
        p = @a.cols();
        n = @b.cols();

        jj_vals = (0..n).step(bs);
        kk_vals = (0..p).step(bs);
        ii_vals = (0..m).step(bs);

        triples = jj_vals.product(kk_vals).product(ii_vals);
        for ((jj, kk), ii) in triples {
            j_end = min(jj + bs, n);
            k_end = min(kk + bs, p);
            i_end = min(ii + bs, m);
            block = MatBlock{self, ii, i_end, jj, j_end, kk, k_end};
            block.process();
        }
        return @result;
    }

}

class MatBlock {
    @matmul : MatMul
    @ii : i32
    @i_end : i32
    @jj : i32
    @j_end : i32
    @k_start : i32
    @k_end : i32

    getters @matmul, @ii, @i_end, @jj, @j_end, @k_start, @k_end

    def init(@matmul : MatMul, @ii : i32, @i_end : i32, @jj : i32, @j_end : i32, @k_start : i32, @k_end : i32) {}

    def process() {
        i = @ii;
        while i < @i_end {
            rs = self.row_size(i);
            self.process_strip(i, rs);
            i = i + rs;
        }
    }

    def process_strip(i : i32, rs : i32) {
        j = @jj;
        while j < @j_end {
            cs = self.col_size(rs, j);
            self.make_tile(rs, cs, i, j).process();
            j = j + cs;
        }
    }

    def row_size(i : i32) -> i32 {
        if i + 16 <= @i_end { return 16; }
        if i + 8 <= @i_end { return 8; }
        return 1;
    }

    def col_size(rs : i32, j : i32) -> i32 {
        if rs >= 8 and j + 4 <= @j_end { return 4; }
        return 1;
    }

    def make_tile(rs : i32, cs : i32, i : i32, j : i32) -> Tile {
        if rs == 16 and cs == 4 { return Tile16x4{self, i, j}; }
        if rs == 16 and cs == 1 { return Tile16x1{self, i, j}; }
        if rs == 8  and cs == 4 { return Tile8x4{self, i, j}; }
        if rs == 8  and cs == 1 { return Tile8x1{self, i, j}; }
        return Tile1x1{self, i, j};
    }
}

class Tile {
    @block : MatBlock
    @i : i32
    @j : i32

    def init(@block : MatBlock, @i : i32, @j : i32) {}

    abstract def process() {}
}

class Tile1x1 extends Tile {

    def process() {
        i = @i;
        j = @j;
        matmul = @block.matmul();
        k_start = @block.k_start();
        k_end = @block.k_end();
        a = matmul.a();
        b = matmul.b();
        result = matmul.result();

        c_val = result.[i, j];
        for k in k_start..k_end {
            c_val = c_val + a.[i, k] * b.[k, j];
        }
        result.[i, j] = c_val;
    }

}

class Tile8x1 extends Tile {

    def process() {
        i = @i;
        j = @j;
        matmul = @block.matmul();
        k_start = @block.k_start();
        k_end = @block.k_end();
        a = matmul.a();
        b = matmul.b();
        result = matmul.result();

        c_vec = result.get_simd(i, j);
        for k in k_start..k_end {
            a_vec = a.get_simd(i, k);
            bk = (8 of b.[k, j]);
            c_vec = c_vec + a_vec * bk;
        }
        result.set_simd(i, j, c_vec);
    }

}

class Tile8x4 extends Tile {

    def process() {
        i = @i;
        j = @j;
        matmul = @block.matmul();
        k_start = @block.k_start();
        k_end = @block.k_end();
        a = matmul.a();
        b = matmul.b();
        result = matmul.result();

        c0 = result.get_simd(i, j);
        c1 = result.get_simd(i, j + 1);
        c2 = result.get_simd(i, j + 2);
        c3 = result.get_simd(i, j + 3);

        for k in k_start..k_end {
            a_vec = a.get_simd(i, k);
            b0 = (8 of b.[k, j]);
            b1 = (8 of b.[k, j + 1]);
            b2 = (8 of b.[k, j + 2]);
            b3 = (8 of b.[k, j + 3]);
            c0 = c0 + a_vec * b0;
            c1 = c1 + a_vec * b1;
            c2 = c2 + a_vec * b2;
            c3 = c3 + a_vec * b3;
        }

        result.set_simd(i, j, c0);
        result.set_simd(i, j + 1, c1);
        result.set_simd(i, j + 2, c2);
        result.set_simd(i, j + 3, c3);
    }

}

class Tile16x1 extends Tile {

    def process() {
        i = @i;
        j = @j;
        matmul = @block.matmul();
        k_start = @block.k_start();
        k_end = @block.k_end();
        a = matmul.a();
        b = matmul.b();
        result = matmul.result();

        c_lo = result.get_simd(i, j);
        c_hi = result.get_simd(i + 8, j);

        for k in k_start..k_end {
            a_lo = a.get_simd(i, k);
            a_hi = a.get_simd(i + 8, k);
            bk = (8 of b.[k, j]);
            c_lo = c_lo + a_lo * bk;
            c_hi = c_hi + a_hi * bk;
        }

        result.set_simd(i, j, c_lo);
        result.set_simd(i + 8, j, c_hi);
    }

}

class Tile16x4 extends Tile {

    def process() {
        i = @i;
        j = @j;
        matmul = @block.matmul();
        k_start = @block.k_start();
        k_end = @block.k_end();
        a = matmul.a();
        b = matmul.b();
        result = matmul.result();

        c0_lo = result.get_simd(i, j);
        c0_hi = result.get_simd(i + 8, j);
        c1_lo = result.get_simd(i, j + 1);
        c1_hi = result.get_simd(i + 8, j + 1);
        c2_lo = result.get_simd(i, j + 2);
        c2_hi = result.get_simd(i + 8, j + 2);
        c3_lo = result.get_simd(i, j + 3);
        c3_hi = result.get_simd(i + 8, j + 3);

        for k in k_start..k_end {
            a_lo = a.get_simd(i, k);
            a_hi = a.get_simd(i + 8, k);
            b0 = (8 of b.[k, j]);
            b1 = (8 of b.[k, j + 1]);
            b2 = (8 of b.[k, j + 2]);
            b3 = (8 of b.[k, j + 3]);

            c0_lo = c0_lo + a_lo * b0;
            c0_hi = c0_hi + a_hi * b0;
            c1_lo = c1_lo + a_lo * b1;
            c1_hi = c1_hi + a_hi * b1;
            c2_lo = c2_lo + a_lo * b2;
            c2_hi = c2_hi + a_hi * b2;
            c3_lo = c3_lo + a_lo * b3;
            c3_hi = c3_hi + a_hi * b3;
        }

        result.set_simd(i, j, c0_lo);
        result.set_simd(i + 8, j, c0_hi);
        result.set_simd(i, j + 1, c1_lo);
        result.set_simd(i + 8, j + 1, c1_hi);
        result.set_simd(i, j + 2, c2_lo);
        result.set_simd(i + 8, j + 2, c2_hi);
        result.set_simd(i, j + 3, c3_lo);
        result.set_simd(i + 8, j + 3, c3_hi);
    }

}

def benchmark_matrix_multiplication() {
    size = 2048;

    matrix1 = Matrix.new(size, size);
    matrix2 = Matrix.new(size, size);
    
    for i in 0..size {
        for j in 0..size {
            val1 = (i + j) % 10;
            val2 = (i - j + 10) % 10;
            matrix1.[i, j] = val1 as f64; 
            matrix2.[i, j] = val2 as f64;
        }
    }
    
    start_time = clock();
    result = matrix1 * matrix2;
    end_time = clock();
    
    time_taken = end_time - start_time;
    
    IO.print("Matrix multiplication");
    IO.print("${size} x ${size}");
    IO.print("Time taken: ${time_taken}");
    sum = 0.0;
    for i in 0..size { sum = sum + result.[0, i]; }
    IO.print("Sum of first row (for verification): ${sum}");
}

benchmark_matrix_multiplication();
