import core;

class KeyNotFound extends Exception {}

class Map[K, V] extends IndexableCollection[K, V, Pair[K, V]] {
    
    abstract def get(key : K) -> V? {}
    abstract def insert(key : K, value : V) {}
    abstract def remove(key : K) -> V? {}

    def indices() -> Collection[K] {
        return self.keys();
    }
    def keys() -> Collection[K] {
        return MapKeys{self};
    }
    def values() -> Collection[V] {
        return MapValues{self};
    }
    def clear() {
        for key in self.keys() { self.remove(key); }
    }
    def contains_key(key : K) -> Bool {
        value = self.get(key);
        return value is V;
    }
    def contains(pair : Pair[K, V], eq : (Pair[K, V], Pair[K, V]) -> Bool) -> Bool {
        key = pair.first();
        value = self.get(key);
        if value is not V { return false; }
        return eq.call(pair, Pair{key, value});
    }
    def get_or(key : K, fallback : V) -> V {
        value = self.get(key);
        if value is V { return value; }
        return fallback;
    }
    def get_or_insert(key : K, fallback : V) -> V {
        value = self.get(key);
        if value is V { return value; }
        self.insert(key, fallback);
        return fallback;
    }
    def get_or_insert_with(key : K, fallback_fn : (K) -> V) -> V {
        value = self.get(key);
        if value is V { return value; }
        fallback = fallback_fn.call(key);
        self.insert(key, fallback);
        return fallback;
    }
    def remove_or(key : K, fallback : V) -> V {
        value = self.remove(key);
        if value is V { return value; }
        return fallback;
    }
    def update(key : K, f : (V) -> V) -> Bool {
        value = self.get(key);
        if value is not V { return false; }
        self.insert(key, f.call(value));
        return true;
    }
    def update_or_insert(key : K, update_fn : (V) -> V, fallback_fn : (K) -> V) -> V {
        value = self.get(key);
        if value is V {
            updated = update_fn.call(value);
            self.insert(key, updated);
            return updated;
        }
        fallback = fallback_fn.call(key);
        self.insert(key, fallback);
        return fallback;
    }
    def [](key : K) -> V {
        val = self.get(key);
        if val is V { return val; }
        yield(KeyNotFound{});
    }
    def []=(key : K, value : V) {
        self.insert(key, value);
    }
}

class MapKeys[K, V] extends Collection[K] {
    @map : Map[K, V]

    def init(@map : Map[K, V]) {
    }
    def size() -> i32 {
        return @map.size();
    }
    def iterator() -> Iterator[K] {
        return MapKeyIterator{@map.iterator()};
    }
}

class MapValues[K, V] extends Collection[V] {
    @map : Map[K, V]

    def init(@map : Map[K, V]) {
    }
    def size() -> i32 {
        return @map.size();
    }
    def iterator() -> Iterator[V] {
        return MapValueIterator{@map.iterator()};
    }
}

class MapKeyIterator[K, V] extends Iterator[K] {
    @map_iterator : Iterator[Pair[K, V]]

    regions { $nxt == @map_iterator$nxt.first }

    def init(@map_iterator : Iterator[Pair[K, V]]) {}

    def next() -> K? {
        pair = @map_iterator.next();
        if pair is Pair[K, V] { return pair.first(); }
        return nil;
    }
}

class MapValueIterator[K, V] extends Iterator[V] {
    @map_iterator : Iterator[Pair[K, V]]

    regions { $nxt == @map_iterator$nxt.second }

    def init(@map_iterator : Iterator[Pair[K, V]]) {}

    def next() -> V? {
        pair = @map_iterator.next();
        if pair is Pair[K, V] { return pair.second(); }
        return nil;
    }
}

class HashMap[K, V] extends Map[K, V] {
    // You can construct a HashMap with a hash function and an equality function
    abstract def init(hasher: (K) -> i32, eq : (K, K) -> Bool) {}
}
