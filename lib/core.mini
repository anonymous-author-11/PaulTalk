import builtins;
import iteration;
import collection;
import writer;
import list;
import stack;
import indexable;
import range;
import ascii;
import unicode;
import peek;
import stacktrace;

class Representable {
    def repr() -> String { return "Object"; }
}

class String extends List[Character], Representable {
    @bytes : Buffer[i8]
    @byte_length : i32
    @char_length : i32 // Number of unicode codepoints
    @capacity: i32

    getters @byte_length, @char_length, @capacity

    def Self.empty() -> Self { return Self{}; }

    def Self.from_iterable(iterable : Iterable[Character]) -> Self {
        return Self.empty().extend(iterable);
    }

    // Strict, failable constructor. Validates input and can yield an error.
    def Self.from_bytes(source_bytes: Collection[i8]) -> String yields InvalidUTF8Error {
        result = String{source_bytes.size()};    // Pre-allocate
        validator = UTF8BytesValidator{result.bytes().writer()};
        n_chars = validator.write_codepoints_from(source_bytes.iterator());
        result.increment_chars(n_chars);
        return result;
    } ~> no_alias

    // Lossy constructor. Never fails, replaces invalid sequences with '�'.
    // Consequently, byte length of resultant string may be different than source length
    def Self.from_bytes_lossy(source_bytes: Collection[i8]) -> String {
        result = String{source_bytes.size()};    // Pre-allocate
        validator = UTF8BytesValidator.lossy(result.bytes().writer());
        n_chars = validator.write_codepoints_from(source_bytes.iterator());
        result.increment_chars(n_chars);
        return result;
    } ~> no_alias

    // Construct from a null-terminated buffer of bytes
    def Self.from_c_string(c_string : Buffer[i8]) -> String {
        size = 0;
        while c_string.[size] != (0 as i8) { size = size + 1; } // count bytes
        return String.from_bytes_lossy(Slice{c_string, size}); // default to lossy conversion
    } ~> no_alias

    def Self.from_char(char : Character) -> String {
        str = String{char.n_bytes()};
        str.codepoints().writer().write(char.codepoint());
        return str;
    }

    def init() {
        @bytes = Buffer[i8].new(1);
        @capacity = 1;
        @byte_length = 0;
        @char_length = 0;
    }
    def init(@capacity : i32) {
        @bytes = Buffer[i8].new(@capacity);
        @byte_length = 0;
        @char_length = 0;
    }
    // Constructor for internal use.
    def init(@bytes : Buffer[i8], @byte_length : i32, @char_length : i32, @capacity : i32) {
    }
    def size() -> i32 { return @char_length; }

    def c_string() -> Buffer[i8] {
        buf = Buffer[i8].new(@byte_length + 1);
        for i in 0..@byte_length { buf.[i] = @bytes.[i]; }
        null = 0 as i8;
        buf.[@byte_length] = null;
        return buf;
    } ~> no_alias
    def append(x : Character) -> Self {
        self.writer().write(x);
        return self;
    }
    def extend(other : Iterator[Character]) -> Self {
        self.writer().write_from(other);
        return self;
    }
    def extend(other : Iterable[Character]) -> Self {
        self.writer().write_from(other);
        return self;
    }
    // We know the other string is already valid and don't need to validate
    def extend(other : String) -> Self {
        // We know exactly how many bytes to reserve
        other_b_len = other.byte_length();
        old_b_len = @byte_length;
        new_b_len = old_b_len + other_b_len;
        self.reserve(new_b_len);
        for i in 0..other_b_len {
            @bytes.[i + old_b_len] = other.unchecked_index(i);
        }
        @byte_length = new_b_len;
        @char_length = @char_length + other.size();
        return self;
    }
    def copy_into(dest : Buffer[i8], offset : i32) {
        for i in 0..@byte_length {
            dest.[offset + i] = @bytes.[i];
        }
    }
    def replace(old : String, new : String) -> String {
        if old.is_empty() { return self.copy(); }
        return new.join(self.split(old).map((v : StringView) => { v.to_string(); }));
    }
    def reserve(new_capacity : i32) {
        if new_capacity <= @capacity { return; }
        @capacity = new_capacity;
        old_bytes = @bytes;
        @bytes = Buffer[i8].new(@capacity);
        for i in 0..@byte_length { @bytes.[i] = old_bytes.[i]; }
    } ~> no_alias
    def ==(other : String) -> Bool {
        if @byte_length != other.byte_length() { return false; }
        for i in 0..@byte_length {
            if @bytes.[i] != other.unchecked_index(i) { return false; }
        }
        return true;
    }
    def !=(other : String) -> Bool {
        return not (self == other);
    }
    def find_view(needle : String) -> StringView? {
        source_len = @byte_length;
        needle_len = needle.byte_length();
        if needle_len == 0 { return StringView{self, 0, 0, 0}; }
        if needle_len > source_len { return nil; }
        last_start = source_len - needle_len;
        bytes = self.bytes();
        for start in 0...last_start {
            if not bytes.match_at(needle, start) { continue; }
            end = start + needle_len;
            return StringView{self, start, end, needle.char_length()};
        }
        return nil;
    }
    def starts_with(prefix : String) -> Bool {
        return self.bytes().starts_with(prefix);
    }
    def ends_with(suffix : String) -> Bool {
        return self.bytes().ends_with(suffix);
    }
    def contains(needle : String) -> Bool {
        return self.bytes().contains(needle);
    }
    def lead_whitespace() -> i32 {
        for i in 0..@byte_length {
            if not ASCII.is_whitespace(@bytes.[i]) { return i; }
        }
        return @byte_length;
    }
    def trail_whitespace() -> i32 {
        for i in 0..@byte_length {
            idx = @byte_length - i - 1;
            if not ASCII.is_whitespace(@bytes.[idx]) { return i; }
        }
        return @byte_length;
    }
    def trim_start() -> String {
        start = self.lead_whitespace();
        slice_len = @byte_length - start;
        copied = Buffer[i8].new(slice_len);
        for i in 0..slice_len { copied.[i] = @bytes.[start + i]; }
        chars = @char_length - start;
        return String{copied, slice_len, chars, slice_len};
    }
    def trim_end() -> String {
        removed = self.trail_whitespace();
        end_exclusive = @byte_length - removed;
        copied = Buffer[i8].new(end_exclusive);
        for i in 0..end_exclusive { copied.[i] = @bytes.[i]; }
        chars = @char_length - removed;
        return String{copied, end_exclusive, chars, end_exclusive};
    }
    def trim() -> String {
        start = self.lead_whitespace();
        trail_whitespace = self.trail_whitespace();
        end_exclusive = @byte_length - trail_whitespace;
        if end_exclusive < start { end_exclusive = start; }
        slice_len = end_exclusive - start;
        copied = Buffer[i8].new(slice_len);
        for i in 0..slice_len { copied.[i] = @bytes.[start + i]; }
        removed = start + trail_whitespace;
        if removed > @char_length { removed = @char_length; }
        chars = @char_length - removed;
        return String{copied, slice_len, chars, slice_len};
    }
    def repeat(times : i32) -> String {
        if times <= 0 { return ""; }
        result = String{@byte_length * times};
        for i in 0..times { result.extend(self); }
        return result;
    }
    def join(parts : Iterable[String]) -> String {
        iterator = parts.iterator();
        first_part = iterator.next();
        if first_part is Nil { return ""; }
        return self.join(first_part, iterator);
    }
    def join(parts : Collection[String]) -> String {
        scan = parts.iterator();
        first_part = scan.next();
        if first_part is Nil { return ""; }

        // count total bytes for preallocation
        own_bytes = self.byte_length();
        capacity = first_part.byte_length();
        part = scan.next();
        while part is String {
            capacity = capacity + own_bytes + part.byte_length();
            part = scan.next();
        }

        iterator = parts.iterator();
        iterator.next();
        accumulator = String{capacity}.extend(first_part);
        return self.join(accumulator, iterator);
    }
    def join(accumulator : String, iterator : Iterator[String]) -> String {
        part = iterator.next();
        while part is String {
            accumulator.extend(self);
            accumulator.extend(part);
            part = iterator.next();
        }
        return accumulator;
    }
    def split(delimiter : String) -> Iterable[StringView] {
        return SplitString{self, delimiter};
    }
    // Because both segments are produced eagerly, we defer counting bytes
    // Elements of pair will actually always be ValidStringBytes at runtime
    def split_once(sep : String) -> Pair[StringBytes, StringBytes]? {
        return self.bytes().split_once(sep);
    }
    def rsplit_once(sep : String) -> Pair[StringBytes, StringBytes]? {
        return self.bytes().rsplit_once(sep);
    }
    def lines() -> Iterable[StringView] {
        return self.split("\n");
    }
    def unchecked_index(x : i32) -> i8 {
        return @bytes.[x];
    }
    def copy() -> Self {
        new_buf = Buffer[i8].new(@byte_length);
        for i in 0..@byte_length { new_buf.[i] = @bytes.[i]; }
        return String{new_buf, @byte_length, @char_length, @byte_length};
    }
    def reserve_extra(n : i32) {
        self.reserve(n + @byte_length);
    } ~> no_alias
    def increment_chars(n : i32) {
        @char_length = @char_length + n;
    } ~> no_alias
    def append_byte(byte : i8) {
        new_len = @byte_length + 1;
        if new_len > @capacity {
            grown_capacity = @capacity * 2;
            if grown_capacity < new_len { grown_capacity = new_len; }
            self.reserve(grown_capacity);
        }
        @bytes.[@byte_length] = byte;
        @byte_length = new_len;
    } ~> no_alias
    def repr() -> String {
        return self;
    } ~> { ret == self }
    def to_view() -> StringView {
        return StringView{self, 0, @byte_length, @char_length};
    } ~> { ret.str == self }
    def codepoints() -> StringCodePoints {
        return StringCodePoints{self};
    } ~> { ret.str == self }
    def bytes() -> StringBytesList {
        return StringBytesList{self};
    } ~> { ret.str == self }
    def iterator() -> Iterator[Character] {
        return self.codepoints().map((cp : i32) => { Character{cp}; }).iterator();
    } ~> { ret.str == self }
    def writer() -> StringWriter {
        return StringWriter{self};
    } ~> { ret.string == self }

}

class SplitString extends Iterable[StringView] {
    @source : String
    @delimiter : String

    def init(@source : String, @delimiter : String) {}

    def iterator() -> SplitStringIterator {
        return SplitStringIterator{@source, @delimiter};
    } ~> { ret.source == @source, ret.delimiter == @delimiter }
}

class SplitStringIterator extends Iterator[StringView] {
    @source : String
    @delimiter : String
    @cursor : i32
    @done : Bool

    regions { $nxt.str == @source }

    def init(@source : String, @delimiter : String) {
        @cursor = 0;
        @done = false;
    }

    def build_segment(start : i32, end_exclusive : i32) -> StringView {
        return ValidStringBytesView{@source, start, end_exclusive}.to_string_view();
    } ~> { ret == $nxt }

    def find_delimiter(last_start : i32) -> i32? {
        source = @source.bytes();
        for scan in @cursor...last_start {
            if source.match_at(@delimiter, scan) { return scan; }
        }
        return nil;
    } ~> no_alias

    def next() -> StringView? {
        if @done { return nil; }

        source_len = @source.byte_length();
        delimiter_len = @delimiter.byte_length();
        if delimiter_len == 0 {
            @done = true;
            return self.build_segment(0, source_len);
        }

        start = @cursor;
        if start > source_len {
            @done = true;
            return nil;
        }

        last_start = source_len - delimiter_len;
        next_delimiter = self.find_delimiter(last_start);
        if next_delimiter is i32 {
            @cursor = next_delimiter + delimiter_len;
            return self.build_segment(start, next_delimiter);
        }

        @done = true;
        return self.build_segment(start, source_len);
    }
}

class StringCodePoints extends List[i32] {
    @str : String

    regions { $elems == @str$elems }

    def Self.empty() -> Self {
        return Self{""};
    }
    def Self.from_iterable(iterable : Iterable[i32]) -> Self {
        return Self.empty().extend(iterable);
    }
    def init(@str : String) {
    }
    def size() -> i32 {
        return @str.char_length();
    }
    def append(x : i32) -> Self {
        self.writer().write(x);
        return self;
    }
    def extend(other : Iterable[i32]) -> Self {
        self.writer().write_from(other);
        return self;
    }
    def writer() -> Writer[i32] {
        return StringCodepointWriter{@str};
    } ~> { ret.string == @str, ret$dest == $elems }
    def iterator() -> StringCodepointIterator {
        return StringCodepointIterator{@str};
    } ~> { ret.str == @str }
}

class StringBytes extends Collection[i8] {
    $source : Region

    regions { $elems == $source$elems }

    abstract def source() -> String ~> { ret == $source }
    abstract def start() -> i32 ~> no_alias
    abstract def end() -> i32 ~> no_alias

    // StringBytes may have an invalid start or end due to slicing
    abstract def validate() -> ValidStringBytes {
    } ~> { ret == self } // conservative assumption

    def size() -> i32 {
        return self.end() - self.start();
    }

    def iterator() -> StringBytesIterator {
        return StringBytesIterator{self};
    } ~> { ret.bytes == self }

    def bounds_check(index : i32) yields OutOfBounds {
        length = self.size();
        if index < 0 or index >= length {
            yield(OutOfBounds.new(length, index));
        }
    }

    def unchecked_index(index : i32) -> i8 {
        return self.source().unchecked_index(self.start() + index);
    }

    def [](indices : i32) -> i8 yields OutOfBounds {
        self.bounds_check(indices);
        return self.unchecked_index(indices);
    }

    def [](indices : Range) -> StringBytes {
        iterator = indices.iterator();
        first = iterator.next();
        if first is not i32 { return self.slice(0, 0); }

        last = first;
        next = iterator.next();
        while next is i32 {
            if next != last + 1 { yield(InvalidSliceRange{}); }
            last = next;
            next = iterator.next();
        }
        return self.slice(first, last + 1);
    }

    def split_once(sep : String) -> Pair[StringBytes, StringBytes]? {
        return self.split_once(sep, true);
    }

    def rsplit_once(sep : String) -> Pair[StringBytes, StringBytes]? {
        return self.split_once(sep, false);
    }

    def split_once(sep : String, from_left : Bool) -> Pair[StringBytes, StringBytes]? {
        sep_len = sep.byte_length();
        if sep_len == 0 { return nil; }

        pos : i32?;
        if from_left { pos = self.index_of(sep); }
        else { pos = self.last_index_of(sep); }
        if pos is not i32 { return nil; }

        after_start = pos + sep_len;
        return Pair{self.prefix(pos), self.suffix(after_start)};
    }

    def prefix(separator_index : i32) -> StringBytes {
        return StringBytesView{self.source(), self.start(), self.start() + separator_index};
    }

    def suffix(separator_index : i32) -> StringBytes {
        return StringBytesView{self.source(), self.start() + separator_index, self.end()};
    }

    def slice(start : i32, end_exclusive : i32) -> StringBytes yields OutOfBounds {
        length = self.size();
        if start < 0 or start > length {
            yield(OutOfBounds.new(length, start));
        }
        if end_exclusive < start or end_exclusive > length {
            yield(OutOfBounds.new(length, end_exclusive));
        }
        base = self.start();
        source = self.source();
        return StringBytesView{source, base + start, base + end_exclusive};
    }

    def starts_with(prefix : String) -> Bool {
        prefix_len = prefix.byte_length();
        if prefix_len > self.size() { return false; }
        return self.match_at(prefix, 0);
    }

    def ends_with(suffix : String) -> Bool {
        suffix_len = suffix.byte_length();
        if suffix_len > self.size() { return false; }
        offset = self.size() - suffix_len;
        return self.match_at(suffix, offset);
    }

    def match_at(needle : String, start : i32) -> Bool {
        if start < 0 { return false; }
        needle_len = needle.byte_length();
        if start + needle_len > self.size() { return false; }
        for i in 0..needle_len {
            left = self.unchecked_index(start + i);
            if left != needle.unchecked_index(i) { return false; }
        }
        return true;
    } ~> no_alias

    def contains(needle : String) -> Bool {
        return self.index_of(needle) is i32;
    }

    def index_of(needle : String) -> i32? {
        needle_len = needle.byte_length();
        if needle_len == 0 { return 0; }
        length = self.size();
        if needle_len > length { return nil; }
        last_start = length - needle_len;
        for start in 0...last_start {
            if self.match_at(needle, start) { return start; }
        }
        return nil;
    }

    def last_index_of(needle : String) -> i32? {
        needle_len = needle.byte_length();
        if needle_len == 0 { return 0; }
        length = self.size();
        if needle_len > length { return nil; }
        start = length - needle_len;
        while start >= 0 {
            if self.match_at(needle, start) { return start; }
            start = start - 1;
        }
        return nil;
    }

    def to_string_view() -> StringView yields InvalidUTF8Error {
        return self.validate().to_string_view();
    } ~> { ret.str == $source }

    def to_string() -> String yields InvalidUTF8Error {
        return self.to_string_view().to_string();
    }
}

class ValidStringBytes extends StringBytes {

    def count_chars() -> i32 {
        n_chars = 0;
        for byte in self {
            if not UTF8.is_continuation(byte) { n_chars = n_chars + 1; }
        }
        return n_chars;
    } ~> no_alias

    def prefix(separator_index : i32) -> ValidStringBytes {
        return ValidStringBytesView{self.source(), self.start(), self.start() + separator_index};
    }

    def suffix(separator_index : i32) -> ValidStringBytes {
        return ValidStringBytesView{self.source(), self.start() + separator_index, self.end()};
    }

    def to_string_view() -> StringView {
        return StringView{self.source(), self.start(), self.end(), self.count_chars()};
    }

    def validate() -> Self {
        return self;
    }

}

class StringBytesList extends ValidStringBytes, List[i8] {
    @str : String

    regions { $source == @str }

    def Self.empty() -> Self {
        return Self{""};
    }
    def Self.from_iterable(iterable : Iterable[i8]) -> Self {
        return Self.empty().extend(iterable);
    }
    def init(@str : String) {
    }
    def source() -> String {
        return @str;
    }
    def start() -> i32 {
        return 0;
    }
    def end() -> i32 {
        return @str.byte_length();
    }
    def append(x : i8) -> Self {
        self.writer().write(x);
        return self;
    }
    def extend(other : Iterable[i8]) -> Self {
        self.writer().write_from(other);
        return self;
    }
    def count_chars() -> i32 {
        return @str.char_length();
    }
    def writer() -> Writer[i8] {
        return StringByteWriter{@str};
    } ~> { ret.string == @str, ret$dest == $elems }
}

class StringBytesView extends StringBytes {
    @str : String
    @start : i32
    @end_exclusive : i32

    regions { $source == @str }

    getters @start

    def init(@str : String, @start : i32, @end_exclusive : i32) {
    }

    def source() -> String {
        return @str;
    }
    def end() -> i32 {
        return @end_exclusive;
    }

    def validate() -> ValidStringBytesView yields InvalidUTF8Error {
        source = self.source();
        start = self.start();
        end_exclusive = self.end();
        source_len = source.byte_length();

        if start < source_len {
            start_byte = source.unchecked_index(start);
            if UTF8.is_continuation(start_byte) { yield(InvalidUTF8Error{}); }
        }
        if end_exclusive < source_len {
            end_byte = source.unchecked_index(end_exclusive);
            if UTF8.is_continuation(end_byte) { yield(InvalidUTF8Error{}); }
        }

        return ValidStringBytesView{source, start, end_exclusive};
    } ~> { ret.str == @str } // more precise override annotation
}

class ValidStringBytesView extends ValidStringBytes, StringBytesView {}

class StringView {
    @str : String
    @start : i32
    @end_exclusive : i32
    @char_length : i32

    getters @char_length, @start, @end_exclusive

    def init(@str : String, @start : i32, @end_exclusive : i32, @char_length : i32) {}

    def byte_length() -> i32 {
        return @end_exclusive - @start;
    }

    def is_empty() -> Bool {
        return self.byte_length() == 0;
    }

    def ==(other : String) -> Bool {
        if self.byte_length() != other.byte_length() { return false; }
        return self.bytes().match_at(other, 0);
    }

    def !=(other : String) -> Bool {
        return not (self == other);
    }

    def to_string() -> String {
        n_bytes = self.byte_length();
        bytes = Buffer[i8].new(n_bytes);
        for i in 0..n_bytes { bytes.[i] = @str.unchecked_index(@start + i); }
        return String{bytes, n_bytes, @char_length, n_bytes};
    } ~> no_alias

    def bytes() -> ValidStringBytesView {
        return ValidStringBytesView{@str, @start, @end_exclusive};
    } ~> { ret.str == @str }

}

class StringBytesIterator extends ConstantTimeIterator[i8] {
    @bytes : StringBytes
    @cursor : i32

    regions { $elems == @bytes$elems }

    getter @bytes

    def init(@bytes : StringBytes) {
        @cursor = 0;
    }

    def byte_position() -> i32 {
        return @bytes.start() + @cursor;
    }

    def slice(n_bytes : i32) -> StringBytes {
        old_cursor = @cursor;
        for i in 0..n_bytes { self.next(); }
        return @bytes.slice(old_cursor, @cursor);
    }

    def next() -> i8? {
        if @cursor >= @bytes.size() { return nil; }
        next = @bytes.unchecked_index(@cursor);
        @cursor = @cursor + 1;
        return next;
    }
}

// Iterator can trust that the source string is valid.
// Constant-time *with respect to the length of the String*
class StringCodepointIterator extends ConstantTimeIterator[i32] {
    @str : String
    @byte_iterator : StringBytesIterator
    @decoder : ValidUTF8Decoder
    @codepoint_cursor : i32

    regions { $elems == @str$elems }

    def init(@str : String) {
        @byte_iterator = @str.bytes().iterator();
        @decoder = ValidUTF8Decoder{@byte_iterator};
        @codepoint_cursor = 0;
    }

    def byte_position() -> i32 {
        return @byte_iterator.byte_position();
    }

    def codepoint_position() -> i32 {
        return @codepoint_cursor;
    }

    def slice(n_codepoints : i32) -> StringView {
        start = self.byte_position();
        taken = 0;
        while taken < n_codepoints {
            nxt = self.next();
            if nxt is Nil { break; }
            taken = taken + 1;
        }
        return StringView{@str, start, self.byte_position(), taken};
    }

    def next() -> i32? {
        next_cp = @decoder.next();
        if next_cp is Nil { return nil; }
        @codepoint_cursor = @codepoint_cursor + 1;
        return next_cp;
    }
}

class StringWriter extends Writer[Character] {
    @string : String
    @encoder : UTF8Encoder

    regions { $dest == @encoder$dest == @string$elems }

    def init(@string : String) {
        @encoder = UTF8Encoder{@string.bytes().writer()};
    }

    def write(value : Character) {
        @string.reserve_extra(value.n_bytes());
        @encoder.write(value.codepoint());
        @string.increment_chars(1);
    }
    // Avoid repeated reserve/copy while encoding known-size collections.
    def write_from(source : Collection[Character], max_elems : i32) -> i32 {
        n_chars = source.size();
        if max_elems > n_chars { max_elems = n_chars; }
        @string.reserve_extra(n_chars * 4);
        return self.write_from(source.iterator(), max_elems);
    }
    // A String has already validated bytes, so we can just write its bytes directly
    def write_from(source : String) -> i32 {
        n_chars = source.char_length();
        @string.bytes().writer().write_from(source.bytes());
        @string.increment_chars(n_chars);
        return n_chars;
    }
}

class StringByteWriter extends Writer[i8] {
	@string : String

    regions { $dest == @string$elems }

	def init(@string : String) {}

	def write(value : i8) {
		@string.append_byte(value);
	}

    // .write_from(bytes) with a single argument will delegate to this override
    def write_from(source : Collection[i8], max_elems : i32) -> i32 {
        n_bytes = source.size();
        if max_elems > n_bytes { max_elems = n_bytes; }
        @string.reserve_extra(max_elems);
        return self.write_from(source.iterator(), max_elems);
    }
}

class StringCodepointWriter extends Writer[i32] {
	@string : String
	@encoder : UTF8Encoder

    regions { $dest == @encoder$dest == @string$elems }

	def init(@string : String) {
		@encoder = UTF8Encoder{@string.bytes().writer()};
	}

	def write(value : i32) {
        width = UTF8.encoded_width(value);
        if width == 0 { return; }
        @string.reserve_extra(width);
		@encoder.write(value);
		@string.increment_chars(1);
	}
    def write_from(source : Iterator[i32], max_elems : i32) -> i32 {
        n_written = @encoder.write_from(source, max_elems);
        @string.increment_chars(n_written);
        return n_written;
    }
}

class Character {
    @codepoint : i32

    getter @codepoint

    def init(@codepoint : i32) {}

    def ==(other : Character) -> Bool {
        return @codepoint == other.codepoint();
    }
    def n_bytes() -> i32 {
        width = UTF8.encoded_width(@codepoint);
        if width == 0 { return 3; } // Use replacement width for invalid codepoints
        return width;
    }
}

class UTF8Encoder extends Writer[i32] {
	@writer : Writer[i8]
    @replacement_fn : (Writer[i8])

    regions { $dest == @writer$dest }

    getter @replacement_fn
    setter @replacement_fn

    def Self.lossy(writer : Writer[i8]) -> UTF8Encoder {
        replacement_fn = (writer : Writer[i8]) => {
            writer.write(0xEF as i8);
            writer.write(0xBF as i8);
            writer.write(0xBD as i8);
        };
        return UTF8Encoder{writer, replacement_fn};
    } ~> { ret.writer == writer }

    // Default is lossless, yield Exception on invalid codepoint
    def init(@writer : Writer[i8]) {
        @replacement_fn = (writer : Writer[i8]) => { yield(InvalidUTF8Error{}); return; };
    }

    def init(@writer : Writer[i8], @replacement_fn : (Writer[i8])) {
    }

	def write(value : i32) {
        width = UTF8.encoded_width(value);
        if width == 1 { // 1-byte
            @writer.write(value as i8);
            return;
        }
        if width == 2 { // 2-byte
            @writer.write((0xC0 bit_or (value >> 6)) as i8);
            @writer.write((0x80 bit_or (value bit_and 0x3F)) as i8);
            return;
        }
        if width == 3 { // 3-byte
            @writer.write((0xE0 bit_or (value >> 12)) as i8);
            @writer.write((0x80 bit_or ((value >> 6) bit_and 0x3F)) as i8);
            @writer.write((0x80 bit_or (value bit_and 0x3F)) as i8);
            return;
        }
        if width == 4 { // 4-byte
            @writer.write((0xF0 bit_or (value >> 18)) as i8);
            @writer.write((0x80 bit_or ((value >> 12) bit_and 0x3F)) as i8);
            @writer.write((0x80 bit_or ((value >> 6) bit_and 0x3F)) as i8);
            @writer.write((0x80 bit_or (value bit_and 0x3F)) as i8);
            return;
        }
        @replacement_fn.call(@writer);
	}

    // optimization: decoder + encoder = byte validator
    def write_from(source : UTF8Decoder, max_elems : i32) -> i32 {
        validator = UTF8BytesValidator{@writer, @replacement_fn};
        return validator.write_codepoints_from(source.peeker(), max_elems);
    } ~> no_alias

    // optimization: validator + encoder = encoder
    def write_from(source : UTF8CodepointsValidator, max_elems : i32) -> i32 {
        iterator = source.iterator();
        n_written = 0;
        codepoint = iterator.next();
        while codepoint is i32 and n_written < max_elems {
            if codepoint > 0x10FFFF { codepoint = source.replacement_fn().call(codepoint); }
            self.write(codepoint);
            n_written = n_written + 1;
            codepoint = iterator.next();
        }
        return n_written;
    } ~> no_alias
}

class UTF8CodepointsValidator extends Iterator[i32] {
    @iterator : Iterator[i32]
    @replacement_fn : (i32) -> i32

    regions { $elems == @iterator$elems }

    getters @iterator, @replacement_fn
    setter @replacement_fn

    def Self.lossy(iterator : Iterator[i32]) -> UTF8CodepointsValidator {
        replacement_fn = (codepoint : i32) => { 0xFFFD as i32; };
        return UTF8CodepointsValidator{iterator, replacement_fn};
    } ~> { ret.iterator == iterator }

    def init(@iterator : Iterator[i32]) {
        @replacement_fn = (codepoint : i32) => {
            yield(InvalidUTF8Error{});
            return -1;
        };
    }

    def init(@iterator : Iterator[i32], @replacement_fn : (i32) -> i32) {
    }

    def next() -> i32? {
        codepoint = @iterator.next();
        if codepoint is Nil { return nil; }
        if codepoint <= 0x10FFFF { return codepoint; }
        return @replacement_fn.call(codepoint);
    }
}

// seems like a BulkWriter[i8], except the i32 returned is the # of *codepoints* written
class UTF8BytesValidator {
    @writer : Writer[i8]
    @replacement_fn : (Writer[i8])

    getter @replacement_fn
    setter @replacement_fn

    def Self.lossy(writer : Writer[i8]) -> UTF8BytesValidator {
        replacement_fn = (writer : Writer[i8]) => {
            writer.write(0xEF as i8);
            writer.write(0xBF as i8);
            writer.write(0xBD as i8);
        };
        return UTF8BytesValidator{writer, replacement_fn};
    } ~> { ret.writer == writer }

    def init(@writer : Writer[i8]) {
        @replacement_fn = (writer : Writer[i8]) => { yield(InvalidUTF8Error{}); return; };
    }

    def init(@writer : Writer[i8], @replacement_fn : (Writer[i8])) {
    }

    // Re-encode bytes for one codepoint from the byte source into @writer
    def write_codepoints_from(source : Iterator[i8], max_elems : i32) -> i32 {
        peeker = source into Peeker;
        n_written = 0;
        while n_written < max_elems {
            b1 = peeker.next();
            if b1 is Nil { return n_written; }
            (codepoint, bytes_needed) = UTF8.classify_lead(b1);

            // Check for invalid start byte
            if bytes_needed == 0 {
                @replacement_fn.call(@writer);
                n_written = n_written + 1;
                continue;
            }

            if bytes_needed == 1 {
                @writer.write(b1);
                n_written = n_written + 1;
                continue;
            }

            temp_buf = Buffer[i8].new(4);
            temp_buf.[0] = b1;
            valid_bytes = true;

            for i in 1..bytes_needed {
                b_next = peeker.peek();
                if b_next is Nil { return n_written; }
                if not UTF8.is_continuation(b_next) {
                    valid_bytes = false;
                    break;
                }
                peeker.next();
                temp_buf.[i] = b_next;
                codepoint = UTF8.accumulate(codepoint, b_next);
            }

            if (not valid_bytes) or (not UTF8.is_valid_codepoint(codepoint, bytes_needed)) {
                @replacement_fn.call(@writer);
                n_written = n_written + 1;
                continue;
            }

            for i in 0..bytes_needed { @writer.write(temp_buf.[i]); }
            n_written = n_written + 1;
        }
        return n_written;
    } ~> no_alias

    def write_codepoints_from(source : Iterator[i8]) -> i32 {
        return self.write_codepoints_from(source, i32.max());
    } ~> no_alias

    def write_codepoints_from(source : Iterable[i8], max_elems : i32) -> i32 {
        return self.write_codepoints_from(source.iterator(), max_elems);
    } ~> no_alias

    def write_codepoints_from(source : Iterable[i8]) -> i32 {
        return self.write_codepoints_from(source.iterator(), i32.max());
    } ~> no_alias
}

// Decodes bytes that are valid UTF8 into codepoints
class ValidUTF8Decoder extends ConstantTimeIterator[i32] {
    @peeker : Peeker[i8]

    regions { $elems == @peeker$elems }

    getters @peeker

    def init(iterator : Iterator[i8]) {
        @peeker = iterator into Peeker;
    }

    def bad_result(b1 : i8) -> i32? {
        return nil; 
    }

    def invalid_continuation(b_next : i8) -> Bool {
        return false;
    }

    def invalid_codepoint(codepoint : i32, bytes_needed : i32) -> Bool {
        return false;
    }

    def next() -> i32? {
        b1 = @peeker.next();
        if b1 is Nil { return nil; }
        (codepoint, bytes_needed) = UTF8.classify_lead(b1);

        // Check for invalid start byte
        if bytes_needed == 0 { return self.bad_result(b1); }

        for i in 1..bytes_needed {
            b_next = @peeker.peek();
            if b_next is Nil { return nil; }
            if self.invalid_continuation(b_next) { // Invalid continuation byte
                return self.bad_result(b1);
            }
            codepoint = UTF8.accumulate(codepoint, b_next);
            b_next = @peeker.next();            // Advance, now that known valid
        }
        
        if self.invalid_codepoint(codepoint, bytes_needed) {
            return self.bad_result(b1); 
        }
        return codepoint;
    }
}

// Decodes UTF8 bytes that may or may not be valid
class UTF8Decoder extends ValidUTF8Decoder {
    @replacement_fn : (i8) -> i32

    getter @replacement_fn
    setter @replacement_fn

    def Self.lossy(iterator : Iterator[i8]) -> UTF8Decoder {
        replacement_fn = (byte : i8) => { 0xFFFD as i32; };
        return UTF8Decoder{iterator, replacement_fn};
    } ~> { ret.iterator == iterator }

    def init(iterator : Iterator[i8]) {
        @peeker = iterator into Peeker;
        @replacement_fn = (byte : i8) => {
            yield(InvalidUTF8Error{});
            return -1;
        };
    }

    def init(iterator : Iterator[i8], @replacement_fn : (i8) -> i32) {
        @peeker = iterator into Peeker;
    }

    def bad_result(b1 : i8) -> i32? {
        return @replacement_fn.call(b1); 
    }

    def invalid_continuation(b_next : i8) -> Bool {
        return not UTF8.is_continuation(b_next);
    }

    def invalid_codepoint(codepoint : i32, bytes_needed : i32) -> Bool {
        return not UTF8.is_valid_codepoint(codepoint, bytes_needed);
    }

}

class Exception {
    @line_number : i32
    @file_name : String
    @message : String
    @stacktrace : Stacktrace

    def init(@message : String) {
        @line_number = 0;
        @file_name = "";
        @stacktrace = Stacktrace{};
    }
    def init() {
        @line_number = 0;
        @message = "<None>";
        @file_name = "";
        @stacktrace = Stacktrace{};
    }

    def message() -> String {
        return @message;
    }

    def set_info(@line_number : i32, @file_name : String) {}

    def report() {
        print(
            "---------\n"
            .extend("Exception thrown from file ${@file_name}")
            .extend(" at line ${@line_number} with message")
            .extend("\n\n${self.message()}\n\nStack trace:\n")
        );
        @stacktrace.print();
        print("---------");
    }
}

class InvalidUTF8Error extends Exception {
    def init() {
        @message = "Invalid UTF-8 sequence encountered during string conversion.";
        @line_number = 0;
        @file_name = "";
        @stacktrace = Stacktrace{};
    }
}

class InvalidSliceRange extends Exception {
    def init() {
        @message = "Slice range must be contiguous and increasing by 1.";
        @line_number = 0;
        @file_name = "";
        @stacktrace = Stacktrace{};
    }
}

class OutOfBounds extends Exception {
    @details : OutOfBoundsDetails?

    def init(bounds : i32, index : i32) {
        @details = OutOfBoundsDetails.new(bounds, index);
        @line_number = 0;
        @file_name = "";
        @message = "An out-of-bounds error occurred while indexing into a collection.";
        @stacktrace = Stacktrace{};
    }
    def message() -> String {
        details = @details;
        if details is Nil { return @message; }
        return "${@message}\n${details.report()}";
    }
}

class OutOfBoundsDetails {
    @bounds : i32
    @index : i32

    def init(@bounds : i32, @index : i32) {}

    def report() -> String {
        return "The size of the collection being indexed was ${@bounds}"
            .extend("\nThe indexing argument was ${@index}");
    }
}

def report_exception(current_coroutine : Coroutine[() -> Exception]) {
    exception = current_coroutine.result();
    if exception is Nil { return; }
    exception.report();
}

// A slice is a constant-length indexable collection
// It is the lowest-level abstraction over a raw Buffer
class Slice[T] extends IndexableCollection[i32, T, T] {
    
    // Having a @start makes Slice useful for views into pre-existing buffers
    @buffer : Buffer[T]
    @length : i32
    @start : i32

    regions { $elems == @buffer }

    def Self.from_collection(collection : Collection[T]) -> Self {
        collection_size = collection.size();
        buf = Buffer[T].new(collection_size);
        i = 0;
        for elem in collection {
            buf.[i] = elem;
            i = i + 1;
        }
        return Slice{buf, collection_size, 0};
    } ~> { ret$elems holds collection$elems }

    def init(@buffer : Buffer[T], @length : i32, @start : i32) {
    }
    def init(@buffer : Buffer[T], @length : i32) {
        @start = 0;
    }
    def size() -> i32 {
        return @length;
    } ~> no_alias
    def indices() -> Range {
        return 0..@length;
    } ~> no_alias
    def values() -> Self {
        return self;
    }
    def unchecked_index(index : i32) -> T {
        return @buffer.[@start + index];
    } ~> { ret holds $elems }
    def unchecked_insert(index : i32, value : T) {
        @buffer.[@start + index] = value;
    } ~> { $elems holds value }
    def [](index : i32) -> T yields OutOfBounds {
        self.bounds_check(index);
        if index < 0 { index = @length + index; }
        return self.unchecked_index(index);
    }
    def []=(index : i32, value : T) yields OutOfBounds {
        self.bounds_check(index);
        if index < 0 { index = @length + index; }
        self.unchecked_insert(index, value);
    }
    def bounds_check(index : i32) yields OutOfBounds {
        past_end = index > (@length - 1);
        before_start = (@length + index) < 0;
        if past_end or before_start {
            yield(OutOfBounds.new(@length, index));
        }
    } ~> no_alias
    def iterator() -> ConstantTimeIterator[T] {
        return SliceIterator{self};
    } ~> { ret.slice == self }
}

class SliceIterator[T] extends ConstantTimeIterator[T] {
    @slice : Slice[T]
    @length : i32   
    @index : i32

    regions { $elems == @slice$elems }

    def init(@slice : Slice[T]) {
        @length = @slice.size(); // Because a Slice is constant-length, we can cache it
        @index = 0;
    }
    def next() -> T? {
        if @index >= @length { return nil; }
        old_index = @index;
        @index = @index + 1;
        return @slice.unchecked_index(old_index);
    }
}

