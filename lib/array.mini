import core;

class Array[T] extends
    IndexedStore[T],
    Stack[T],
    Representable
{
	@buffer : Buffer[T]
	@size : i32
	@capacity : i32

    regions { $elems == @buffer }

    def Self.empty() -> Self { return Self{}; }

    // When iterable is actually a Collection, the optimized dispatch for Array.extend(collection) will be used
    // A great example of why multimethods are so powerful: always dispatches on argument's runtime type
    def Self.from_iterable(iterable : Iterable[T]) -> Self {
        return Self.empty().extend(iterable);
    }

    getters @size, @capacity

	def init() {
		@buffer = Buffer[T].new(1);
		@size = 0;
		@capacity = 1;
	}
    def init(@capacity : i32) {
        if @capacity < 1 { @capacity = 1; }
        @buffer = Buffer[T].new(@capacity);
        @size = 0;
    }
    
    def init(@buffer : Buffer[T], @size : i32, @capacity : i32) {}

    // Representable override
    def repr() -> String { return "Array"; }

    // Indexed[T] overrides

    def get_unchecked(index : i32) -> T { return @buffer.[index]; }

    def canonicalize(index : i32) -> i32 {
        // Allow negative indices to index in reverse
        if index < 0 { return @size + index; }
        return index;
    }
    
    // IndexedStore[T] override
    def put_unchecked(index : i32, value : T) { @buffer.[index] = value; }

    // List[T] overrides

    def append(x : T) -> Self {
        if @size >= @capacity { self.reserve(@capacity * 2); }
        @buffer.[@size] = x;
        @size = @size + 1;
        return self;
    }
    
    def extend(other : Collection[T]) -> Self {
        old_len = @size;
        new_len = old_len + other.size();
        self.reserve(new_len);
        for (i, elem) in other.enumerate() {
            self.put_unchecked(i + old_len, elem);
        }
        @size = new_len;
        return self;
    }

    // Stack[T] overrides

    def pop() -> T? {
        if @size == 0 { return nil; }
        @size = @size - 1;
        return @buffer.[@size];
    }

    def clear() { @size = 0; }

    def remove_at(index : i32) -> T? {
        index = self.canonicalize(index);
        if not self.is_inbounds(index) { return nil; }
        removed = @buffer.[index];
        last_index = @size - 1;
        for i in index..last_index { @buffer.[i] = @buffer.[i + 1]; }
        @size = last_index;
        return removed;
    }

    def copy() -> Array[T] {
        return Array[T]{@capacity}.extend(self);
    }

    def reserve(new_capacity : i32) {
        if new_capacity <= @capacity { return; }
        @capacity = new_capacity;
        old_buffer = @buffer;
        @buffer = Buffer[T].new(@capacity);
        for i in 0..@size { @buffer.[i] = old_buffer.[i]; }
    } ~> no_alias
    
}