import keyed.map;
import swiss_store;

class SwissMap[K, V] extends SwissStore[K, V, Pair[K, V]], Map[K, V] {
    @keys : Buffer[K]
    @values : Buffer[V]

    regions { $keys == @keys, $values == @values }

    def init(@hasher : (K) -> i32, @eq : (K, K) -> Bool) {
        entries_len = min_capacity();
        capacity = padded_capacity(entries_len);
        @keys = Buffer[K].new(entries_len);
        @values = Buffer[V].new(entries_len);
        @hashes = Buffer[i32].new(entries_len);
        @metadata = Buffer[i8].new(capacity);
        @entries_len = entries_len;
        @size = 0;

        for i in entries_len..capacity { @metadata.[i] = padding(); }
    }

    def value_at(index : i32) -> V { return @values.[index]; }

    def key_at(index : i32) -> K { return @keys.[index]; }

    def set_value_at(index : i32, value : V) { @values.[index] = value; }

    def set_key_at(index : i32, key : K) { @keys.[index] = key; }

    def reset_records(capacity : i32) {
        @keys = Buffer[K].new(capacity);
        @values = Buffer[V].new(capacity);
    }

    def resize(new_capacity : i32) {
        old_keys = @keys;
        old_values = @values;
        old_metadata = @metadata;
        old_hashes = @hashes;
        old_len = @entries_len;
        self.reset_table(new_capacity);

        for i in 0..old_len {
            if (old_metadata.[i] bit_and occupied_mask()) == 0 { continue; }
            hash = old_hashes.[i];
            slot = self.find_slot_for_new_hash(hash);
            @keys.[slot] = old_keys.[i];
            @values.[slot] = old_values.[i];
            @hashes.[slot] = hash;
            @metadata.[slot] = h2_to_control(hash);
            @size = @size + 1;
        }
    }

    def scan_next(start_cursor : i32) -> Pair[i32, Pair[K, V]]? {
        if start_cursor >= @entries_len { return nil; }

        for cursor in start_cursor..@entries_len {
            if (@metadata.[cursor] bit_and occupied_mask()) == 0 { continue; }
            entry = Pair{@keys.[cursor], @values.[cursor]};
            return Pair{cursor + 1, entry};
        }
        return nil;
    }
}